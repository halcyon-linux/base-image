# Universal Blue packages Copr repo (ublue-os/packages) — scoped with
# includepkgs. priority=1 makes those packages win over Fedora, while
# includepkgs confines the repo to the ujust/uupd machinery the recipe
# installs (bazaar, ublue-os-*, uupd) plus the ublue-* family for the
# stack's own sub-dependencies — without the allowlist, dnf5 prefers this
# repo for every dependency name it carries (kcm_ublue, oversteer, ...).

[copr:copr.fedorainfracloud.org:ublue-os:packages]
name=Copr repo for packages (ublue-os) — priority 1
baseurl=https://download.copr.fedorainfracloud.org/results/ublue-os/packages/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/ublue-os/packages/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
priority=1
includepkgs=bazaar,uupd,ublue-*

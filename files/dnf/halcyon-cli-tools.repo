# halcyon CLI tools Copr repo — priority 1 (consumed by the dnf module via
# files/dnf/halcyon-cli-tools.repo; the copr plugin sets no priority, so the repo
# file carries it).
#
# priority=1 (dnf: lower number wins; Fedora/Terra default to 99) makes every
# package this repo builds shadow Fedora, Terra and any unprioritized Copr.

[copr:copr.fedorainfracloud.org:aahsnr-work:cli-tools]
name=Copr repo for cli-tools (aahsnr-work) — priority 1
baseurl=https://download.copr.fedorainfracloud.org/results/aahsnr-work/cli-tools/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/aahsnr-work/cli-tools/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
priority=1

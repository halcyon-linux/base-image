repo_gpgcheck=0
enabled=1
enabled_metadata=1
priority=1
includepkgs=google-noto-color-emoji-fonts,jetbrains-mono-fonts-all,nerd-fonts-jetbrainsmono,nerd-fonts-symbols-only,nerd-fonts-ubuntu,nerd-fonts-ubuntu-mono

[copr:copr.fedorainfracloud.org:aahsnr-work:fonts]
name=Copr repo for fonts (aahsnr-work) — priority 1
baseurl=https://download.copr.fedorainfracloud.org/results/aahsnr-work/fonts/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1

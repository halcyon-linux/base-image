# halcyon CLI tools Copr repo (aahsnr-work/cli-tools) — scoped with
# includepkgs. priority=1 makes those packages win over Fedora/Terra, while
# includepkgs confines the repo to exactly the names devtools.yml installs
# (the monorepo also builds xwiimote-ng, yazi, zellij and zoxide, which the
# recipe does not use — the allowlist keeps them unpullable). Keep the list
# in sync with devtools.yml (a missing entry fails loudly with "No match" if
# Fedora lacks the name; a stale entry silently serves Fedora's build).

[copr:copr.fedorainfracloud.org:aahsnr-work:cli-tools]
name=Copr repo for cli-tools (aahsnr-work) — priority 1
baseurl=https://download.copr.fedorainfracloud.org/results/aahsnr-work/cli-tools/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/aahsnr-work/cli-tools/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
priority=1
includepkgs=asdf,atuin,bat,bat-extras,bun,cava,chafa,chafa-libs,cliphist,dust,eza,fd-find,fzf,fzy,gnuplot,kilo,lazygit,marksman,opencode,pandoc,pixi,starship,tealdeer,texlab,topgrade,uv

# halcyon TeX Live Copr repo (aahsnr-work/texlive-packages) — scoped with a
# family glob rather than a name list: the texlive collections depend on
# sibling texlive-* packages that must all resolve from the same stack, so
# the whole family is allowed while priority=1 keeps it ahead of Fedora's
# texlive. Recipe-facing set: texlive.yml.

[copr:copr.fedorainfracloud.org:aahsnr-work:texlive-packages]
name=Copr repo for texlive-packages (aahsnr-work) — priority 1
baseurl=https://download.copr.fedorainfracloud.org/results/aahsnr-work/texlive-packages/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/aahsnr-work/texlive-packages/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
priority=1
includepkgs=texlive-*

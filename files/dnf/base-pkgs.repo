# halcyon desktop core Copr repo (aahsnr-work/base-pkgs) — the Hyprland +
# Noctalia stack, scoped with includepkgs. priority=1 makes those packages win
# over Fedora/Terra, while includepkgs confines the repo to exactly the names
# desktop.yml installs — without the allowlist, dnf5 prefers this repo for
# every dependency name it carries. Keep the list in sync with desktop.yml
# (a missing entry fails loudly with "No match" if Fedora lacks the name; a
# stale entry silently serves Fedora's build).

[copr:copr.fedorainfracloud.org:aahsnr-work:base-pkgs]
name=Copr repo for base-pkgs (aahsnr-work) — priority 1
baseurl=https://download.copr.fedorainfracloud.org/results/aahsnr-work/base-pkgs/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/aahsnr-work/base-pkgs/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
priority=1
includepkgs=adw-gtk3,aquamarine,glaze,hyprcursor,hyprgraphics,hyprland-git,hyprland-guiutils,hyprland-protocols,hyprland-qt-support,hyprlang,hyprpwcenter,hyprshutdown,hyprtoolkit,hyprutils,hyprwayland-scanner,hyprwire,noctalia-git,nwg-displays,nwg-look,pyprland,qt6ct,xdg-desktop-portal-hyprland,xcur2png

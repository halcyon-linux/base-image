# packages-lib — jq accessors for packages.json (ctx root, from repo root).
# Source this file from any stage that consumes the package catalog:
#   source /tmp/files/scripts/lib/packages-lib
# Style follows ublue-os/main's build_files/packages.sh (jq fail-fast
# validation, readarray extraction). packages.json lives at the build config root (/tmp/files).

PACKAGES_JSON="${PACKAGES_JSON:-/tmp/files/packages.json}"

# Fail the build immediately if the catalog is malformed (main pattern).
packages_validate() {
  if ! jq empty "$PACKAGES_JSON" >/dev/null 2>&1; then
    echo "  FAIL  packages.json contains syntax errors and cannot be parsed" >&2
    exit 1
  fi
}

# Print the package names of one include group (e.g. packages_for core).
# A missing group is a build error, not an empty list — the `// []` fallback
# once masked a packages.json rename and produced zero-argument dnf installs.
packages_for() {
  if ! jq -e --arg group "$1" '.all.include | has($group)' "$PACKAGES_JSON" >/dev/null; then
    echo "  FAIL  packages.json has no include group '$1'" >&2
    exit 1
  fi
  jq -r --arg group "$1" '.all.include[$group] | .[]' "$PACKAGES_JSON"
}

# Print the removal list (all.exclude.all) — entries may be absent from the
# base; consumers resolve them through rpm -qa before removing (main pattern).
packages_excludes() {
  jq -r '.all.exclude.all // [] | .[]' "$PACKAGES_JSON"
}

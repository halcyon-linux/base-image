[Unit]
Description=Initializes Chezmoi if directory is missing
# blue-build chezmoi module condition: run only for users with NO existing
# chezmoi source directory (checks the .git dir the module clone creates).
ConditionPathExists=!%h/.local/share/chezmoi/.git/
# --global enablement also reaches the greetd greeter user; only real login
# users should clone and apply the dotfiles.
ConditionUser=!greetd

[Service]
Type=oneshot
# --force: dotfiles are the source of truth (the daily update runs
# --no-tty --force), and a home rebasing from a previous OS already holds
# differing dotfiles — a plain --apply fails non-interactively on the first
# conflict ("already exists").
ExecStart=/usr/bin/chezmoi init --apply --force aahsnr-configs/dotfiles
# network-online.target does not exist in the USER manager, so ordering
# against it cannot guarantee connectivity for the clone; a failed first
# attempt must retry instead of waiting for the next login.
Restart=on-failure
RestartSec=15s
TimeoutStartSec=600

[Install]
WantedBy=default.target

[Plymouth Theme]
Name=halcyon
Description=halcyon boot theme (assets generated at build time by image-info)
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/halcyon
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0b0e14
BackgroundEndColor=0x0b0e14
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.90

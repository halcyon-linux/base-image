#!/bin/bash

# adw-gtk3-dark (Fedora package adw-gtk3-theme) — Colloid-Purple-Dark-Catppuccin
# was the pre-reorg choice but ships in no enabled repo (verified 2026-09-19)
THEME='adw-gtk3-dark'
ICONS='Papirus-Dark'
FONT='JetBrainsMono Nerd Font Medium 13'
CURSOR='Bibata-Modern-Ice'

SCHEMA='gsettings set org.gnome.desktop.interface'

apply_themes() {
	${SCHEMA} gtk-theme "$THEME"
	${SCHEMA} icon-theme "$ICONS"
	${SCHEMA} cursor-theme "$CURSOR"
	${SCHEMA} font-name "$FONT"
}

apply_themes

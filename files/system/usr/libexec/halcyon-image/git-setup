# =============================================================================
# MAIN FUNCTION
# =============================================================================

main() {
    print_header

    check_dependencies

    echo ""
    print_info "This script will CLEAN UP managed configurations and set up"
    print_info "SSH keys, GPG keys (for commit signing), Git config, and GitHub CLI"
    print_info "for multiple GitHub accounts."
    print_info "Non‑managed SSH keys will be left untouched."
    echo ""
    print_info "Detected distribution: ${BOLD}${DISTRO}${NC}"
    echo ""

    # Comprehensive cleanup (scoped)
    cleanup_all_configs

    # GPG must come before configure_git so signing keys can be embedded
    setup_gpg_agent
    generate_gpg_keys

    # Generate SSH keys
    generate_ssh_keys

    # Configure SSH
    configure_ssh

    # Configure Git (includes per-account GPG signing key now that keys exist)
    configure_git

    # Back up GPG secret keys
    backup_gpg_keys

    # Setup SSH agent (only if agent is running)
    setup_ssh_agent

    # Configure GitHub CLI
    configure_github_cli

    # Verify everything
    if verify_setup; then
        display_public_keys
        display_instructions
    else
        print_error "Setup verification failed. Please check the errors above."
        exit 1
    fi
}


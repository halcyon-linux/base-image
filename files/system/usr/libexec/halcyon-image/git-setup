display_public_keys() {
    print_section "Public Keys for GitHub"

    echo "Copy these public keys to your respective GitHub accounts:"
    echo ""
    echo "GitHub Settings → SSH and GPG keys → New SSH key"
    echo ""

    for account in configs personal work common; do
        if [[ -v ACCOUNTS[${account}] ]]; then
            local pub_file="${SSH_DIR}/id_ed25519_halcyon_${account}.pub"

            if [[ -f "${pub_file}" ]]; then
                echo -e "${BOLD}${CYAN}╭─ Account: ${GIT_NAMES[${account}]} (${ACCOUNTS[${account}]})${NC}"
                echo -e "${YELLOW}│${NC}"

                local pubkey
                pubkey=$(cat "${pub_file}")
                echo -e "${YELLOW}│${NC} ${pubkey}"

                local fingerprint
                fingerprint=$(ssh-keygen -lf "${pub_file}" 2>/dev/null | awk '{print $2}')
                echo -e "${YELLOW}│${NC}"
                echo -e "${YELLOW}│${NC} SSH Fingerprint: ${fingerprint}"

                if gpg_key_exists "${ACCOUNTS[${account}]}"; then
                    local gpg_fp
                    gpg_fp=$(gpg_key_fingerprint "${ACCOUNTS[${account}]}")
                    echo -e "${YELLOW}│${NC} GPG Fingerprint: ${gpg_fp}"
                fi

                echo -e "${YELLOW}╰───────────────────────────────────────────────────────────────${NC}"
                echo ""
            fi
        fi
    done

    echo ""
    echo "For GPG keys (GitHub Settings → SSH and GPG keys → New GPG key):"
    echo ""
    for account in configs personal work common; do
        local email="${ACCOUNTS[${account}]}"
        if gpg_key_exists "${email}"; then
            echo -e "${BOLD}${CYAN}GPG public key for ${account} (${email}):${NC}"
            gpg --armor --export "${email}" 2>/dev/null
            echo ""
        fi
    done
}


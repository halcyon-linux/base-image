#!/usr/bin/env bash
#
# git-crypt-setup.sh - Encrypt secrets in a Git repository using git-crypt
# This script initializes git-crypt, sets up GPG, and creates .gitattributes rules.
# After running it, sensitive files are transparently encrypted on push.
#
# Usage: ./git-crypt-setup.sh [REPO_PATH]
#   If REPO_PATH is omitted, uses the current directory.
#
# Requirements: git, gpg (will install git-crypt if missing)
# Compatible with: Arch Linux, Gentoo Linux, or any system with build tools.
#
# License: GPL-3.0

set -euo pipefail

# print_section is defined in git-setup; duplicated here so this
# script is self-contained
print_section() {
    echo ""
    echo -e "${BOLD}${BLUE}═══ $* ═══${NC}"
    echo ""
}

shopt -s nullglob

# =============================================================================
# CONSTANTS
# =============================================================================

readonly SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
readonly GNUPG_DIR="${HOME}/.gnupg"
readonly GIT_CRYPT_KEY_DIR="${HOME}/.git-crypt-keys"
readonly BACKUP_DIR="${HOME}/.git_crypt_backup_$(date +%Y%m%d_%H%M%S)"

# Detect OS and distribution
readonly OS_TYPE="$(uname -s)"
readonly IS_MACOS=$([[ "${OS_TYPE}" == "Darwin" ]] && echo "true" || echo "false")

detect_distro() {
  if [[ -f /etc/arch-release ]]; then
    echo "arch"
  elif [[ -f /etc/gentoo-release ]]; then
    echo "gentoo"
  elif [[ -f /etc/os-release ]]; then
    source /etc/os-release
    case "${ID:-}" in
    arch) echo "arch" ;;
    gentoo) echo "gentoo" ;;
    *) echo "unknown" ;;
    esac
  else
    echo "unknown"
  fi
}
readonly DISTRO="$(detect_distro)"

# Colors (only if terminal supports it)
if [[ -t 1 ]]; then
  readonly RED='\033[0;31m'
  readonly GREEN='\033[0;32m'
  readonly YELLOW='\033[1;33m'
  readonly BLUE='\033[0;34m'
  readonly CYAN='\033[0;36m'
  readonly BOLD='\033[1m'
  readonly NC='\033[0m'
else
  readonly RED="" GREEN="" YELLOW="" BLUE="" CYAN="" BOLD="" NC=""
fi

# Temporary files cleanup
declare -a TEMP_FILES=()
cleanup() {
  local exit_code=$?
  for f in "${TEMP_FILES[@]}"; do
    if [[ -f "$f" ]]; then rm -f "$f"; elif [[ -d "$f" ]]; then rm -rf "$f"; fi 2>/dev/null || true
  done
  if [[ $exit_code -ne 0 ]]; then
    echo -e "${RED}✗ Script exited with error $exit_code${NC}" >&2
  fi
  exit "$exit_code"
}
trap cleanup EXIT INT TERM

# =============================================================================
# UTILITY FUNCTIONS
# =============================================================================

print_error() { echo -e "${RED}✗ Error: $*${NC}" >&2; }
print_success() { echo -e "${GREEN}✓ $*${NC}"; }
print_warning() { echo -e "${YELLOW}⚠ Warning: $*${NC}"; }
print_info() { echo -e "${BLUE}→ $*${NC}"; }
print_header() {
  echo -e "${BOLD}${CYAN}"
  echo "╔══════════════════════════════════════════════════════════╗"
  echo "║         git-crypt Setup – Encrypt Secrets in Git         ║"
  echo "╚══════════════════════════════════════════════════════════╝"
  echo -e "${NC}"
}

command_exists() { command -v "$1" &>/dev/null; }

confirm() {
  local prompt="$1"
  local response
  while true; do
    read -r -p "$(echo -e "${YELLOW}${prompt} [y/N]: ${NC}")" response
    case "${response}" in
    [Yy] | [Yy][Ee][Ss]) return 0 ;;
    [Nn] | [Nn][Oo] | "") return 1 ;;
    *) echo "Please answer yes or no." ;;
    esac
  done
}

# =============================================================================
# PACKAGE INSTALLATION (git-crypt)
# =============================================================================

install_package_arch() {
  local pkg="$1"
  print_info "Installing $pkg via pacman..."
  sudo pacman -S --noconfirm --needed "$pkg"
}

install_package_gentoo() {
  local pkg="$1"
  print_info "Installing $pkg via emerge..."
  sudo emerge --ask=n --quiet-build "$pkg"
}

install_git_crypt() {
  if command_exists git-crypt; then
    local ver
    ver=$(git-crypt --version 2>/dev/null || echo "unknown")
    print_success "git-crypt already installed: $ver"
    return 0
  fi

  print_info "Installing git-crypt for $DISTRO..."
  case "$DISTRO" in
  arch)
    install_package_arch "git-crypt"
    ;;
  gentoo)
    if command_exists eselect; then
      sudo eselect repository enable guru 2>/dev/null || true
      sudo emaint sync -r guru 2>/dev/null || true
      install_package_gentoo "dev-vcs/git-crypt"
    else
      _install_git_crypt_from_source
    fi
    ;;
  *)
    _install_git_crypt_from_source
    ;;
  esac

  if command_exists git-crypt; then
    print_success "git-crypt installed successfully"
  else
    print_error "Failed to install git-crypt. Please install it manually."
    return 1
  fi
}

_install_git_crypt_from_source() {
  print_info "Building git-crypt from source..."
  local build_dir
  build_dir=$(mktemp -d)
  TEMP_FILES+=("$build_dir")
  if git clone --depth 1 https://github.com/AGWA/git-crypt.git "$build_dir" &>/dev/null; then
    (cd "$build_dir" && make -j"$(nproc)" && sudo make install PREFIX=/usr/local)
    print_success "git-crypt built and installed to /usr/local/bin"
  else
    print_error "Failed to clone git-crypt repository"
    return 1
  fi
}

# =============================================================================
# GPG AGENT SETUP
# =============================================================================

setup_gpg_agent() {
  print_info "Configuring GPG agent..."
  mkdir -p "$GNUPG_DIR"
  chmod 700 "$GNUPG_DIR"

  local agent_conf="$GNUPG_DIR/gpg-agent.conf"
  local pinentry_prog=""
  for candidate in /usr/bin/pinentry-curses /usr/bin/pinentry-qt /usr/bin/pinentry-gnome3 /usr/bin/pinentry-gtk-2 /usr/bin/pinentry; do
    if [[ -x "$candidate" ]]; then
      pinentry_prog="$candidate"
      break
    fi
  done

  cat >"$agent_conf" <<EOF
# gpg-agent.conf – for git-crypt
default-cache-ttl 28800
max-cache-ttl 86400
EOF
  if [[ -n "$pinentry_prog" ]]; then
    echo "pinentry-program $pinentry_prog" >>"$agent_conf"
  fi
  chmod 600 "$agent_conf"

  local gpg_conf="$GNUPG_DIR/gpg.conf"
  if [[ ! -f "$gpg_conf" ]]; then
    cat >"$gpg_conf" <<'EOF'
keyid-format long
with-fingerprint
trust-model direct
EOF
    chmod 600 "$gpg_conf"
  fi

  # Restart agent
  gpgconf --kill gpg-agent 2>/dev/null || true
  gpgconf --launch gpg-agent 2>/dev/null || print_warning "Could not launch gpg-agent (maybe already running)"
}

# =============================================================================
# GPG KEY MANAGEMENT
# =============================================================================

gpg_key_exists() {
  local email="$1"
  gpg --list-secret-keys --keyid-format LONG "$email" &>/dev/null
}

gpg_key_fingerprint() {
  local email="$1"
  gpg --list-keys --with-colons --fingerprint "$email" 2>/dev/null |
    awk -F: '/^fpr:/{print $10; exit}'
}

get_or_create_gpg_key() {
  local email="$1"
  if gpg_key_exists "$email"; then
    local fp
    fp=$(gpg_key_fingerprint "$email")
    print_success "Using existing GPG key for $email (fingerprint: $fp)"
    echo "$fp"
    return 0
  fi

  print_info "No GPG key found for $email. Generating a new Ed25519 key..."
  local name
  read -r -p "Enter your name for this key (e.g., 'Your Name'): " name
  local batch_input
  batch_input=$(mktemp)
  TEMP_FILES+=("$batch_input")

  cat >"$batch_input" <<EOF
Key-Type: eddsa
Key-Curve: Ed25519
Key-Usage: sign,cert
Subkey-Type: ecdh
Subkey-Curve: Curve25519
Subkey-Usage: encrypt
Name-Real: $name
Name-Email: $email
Expire-Date: 2y
%commit
EOF
  print_warning "You will be prompted to set a passphrase for the new GPG key."
  if gpg --batch --gen-key "$batch_input" 2>/dev/null; then
    local fp
    fp=$(gpg_key_fingerprint "$email")
    if [[ -n "$fp" ]]; then
      echo "$fp:6:" | gpg --import-ownertrust 2>/dev/null
      print_success "Generated GPG key for $email: $fp"
      echo "$fp"
      return 0
    fi
  fi
  print_error "Failed to generate GPG key for $email"
  return 1
}

# =============================================================================
# GIT-CRYPT REPOSITORY SETUP
# =============================================================================

create_gitattributes() {
  local repo_dir="$1"
  local gitattributes="$repo_dir/.gitattributes"

  if [[ -f "$gitattributes" ]] && grep -q "filter=git-crypt" "$gitattributes" 2>/dev/null; then
    print_info ".gitattributes already contains git-crypt rules"
    return 0
  fi

  print_info "Creating/updating .gitattributes with encryption rules..."
  cat >>"$gitattributes" <<'EOF'

# ── git-crypt encrypted files ──────────────────────────────────────────────
secrets/**              filter=git-crypt diff=git-crypt
private/**              filter=git-crypt diff=git-crypt
.env                    filter=git-crypt diff=git-crypt
.env.*                  filter=git-crypt diff=git-crypt
*.env                   filter=git-crypt diff=git-crypt
*.key                   filter=git-crypt diff=git-crypt
*.pem                   filter=git-crypt diff=git-crypt
*.p12                   filter=git-crypt diff=git-crypt
*.pfx                   filter=git-crypt diff=git-crypt
*.asc                   filter=git-crypt diff=git-crypt
*credentials*           filter=git-crypt diff=git-crypt
*token*                 filter=git-crypt diff=git-crypt
*secret*                filter=git-crypt diff=git-crypt
*password*              filter=git-crypt diff=git-crypt
auth.json               filter=git-crypt diff=git-crypt
service-account.json    filter=git-crypt diff=git-crypt
*.tfvars                filter=git-crypt diff=git-crypt
*vault*                 filter=git-crypt diff=git-crypt
*-secret.yaml           filter=git-crypt diff=git-crypt
*-secret.yml            filter=git-crypt diff=git-crypt
EOF
  print_success "Updated .gitattributes"
}

init_repo_encryption() {
  local repo_dir="$1"
  local gpg_email="$2"

  cd "$repo_dir" || {
    print_error "Cannot enter $repo_dir"
    return 1
  }

  if [[ -d ".git/git-crypt" ]]; then
    print_info "git-crypt already initialized in this repository"
  else
    print_info "Initializing git-crypt..."
    if git-crypt init; then
      print_success "git-crypt initialized"
    else
      print_error "git-crypt init failed"
      return 1
    fi
  fi

  # Obtain or create GPG key
  local fingerprint
  fingerprint=$(get_or_create_gpg_key "$gpg_email") || return 1

  # Add GPG user
  if git-crypt add-gpg-user --trusted "$fingerprint" 2>/dev/null; then
    print_success "Added GPG user: $gpg_email"
  else
    print_warning "Failed to add GPG user (maybe already added)"
  fi

  # Create .gitattributes
  create_gitattributes "$repo_dir"

  # Export symmetric backup key
  mkdir -p "$GIT_CRYPT_KEY_DIR"
  local repo_name
  repo_name=$(basename "$repo_dir")
  local key_backup="$GIT_CRYPT_KEY_DIR/${repo_name}.git-crypt.key"
  if git-crypt export-key "$key_backup" 2>/dev/null; then
    chmod 600 "$key_backup"
    print_success "Symmetric backup key saved to: $key_backup"
  else
    print_warning "Could not export symmetric key"
  fi

  # Stage .gitattributes if changed
  if git status --short .gitattributes 2>/dev/null | grep -q .; then
    git add .gitattributes
    git commit -m "chore: add git-crypt encryption rules" 2>/dev/null && print_success "Committed .gitattributes"
  fi

  print_success "git-crypt setup complete for $repo_dir"
}

# =============================================================================
# VERIFICATION & INSTRUCTIONS
# =============================================================================

verify_setup() {
  local repo_dir="$1"
  cd "$repo_dir" || return 1
  print_info "Verifying setup..."
  if git-crypt status &>/dev/null; then
    print_success "git-crypt is active."
    echo "  Encrypted files (if any) will have 'encrypted' in git-crypt status."
  else
    print_warning "git-crypt status failed – you may need to 'git-crypt unlock'"
  fi
}

display_instructions() {
  local repo_dir="$1"
  local repo_name
  repo_name=$(basename "$repo_dir")
  echo ""
  print_section "Next Steps"
  cat <<EOF

1. **Unlock the repository** (only needed once per session):
   $ cd "$repo_dir"
   $ git-crypt unlock

   (GPG will prompt for your passphrase via a popup or terminal)

2. **Add secrets** to the repository – they will be encrypted automatically:
   $ echo "API_KEY=secret" > .env
   $ git add .env && git commit -m "Add encrypted env file"
   $ git push

3. **Check which files are encrypted**:
   $ git-crypt status

4. **Temporarily lock** your working copy (unlock again later):
   $ git-crypt lock

5. **Emergency recovery** (if GPG key is lost):
   The symmetric key is at: $GIT_CRYPT_KEY_DIR/${repo_name}.git-crypt.key
   To unlock without GPG: $ git-crypt unlock $GIT_CRYPT_KEY_DIR/${repo_name}.git-crypt.key

6. **Share access with other developers**:
   They need to have your GPG public key imported and trusted.
   Then they can run: $ git-crypt add-gpg-user --trusted <their-fingerprint>

All sensitive files matching patterns in .gitattributes will be encrypted on GitHub
but remain plaintext in your working directory. You can push and pull normally.

EOF
  print_success "Setup complete! 🚀"
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  print_header

  local repo_dir="${1:-.}"
  repo_dir=$(realpath "$repo_dir")

  if [[ ! -d "$repo_dir/.git" ]]; then
    print_error "$repo_dir is not a Git repository. Please run inside a Git repo or specify one."
    exit 1
  fi

  print_info "Target repository: $repo_dir"

  # Check dependencies (git, gpg)
  for cmd in git gpg; do
    if ! command_exists "$cmd"; then
      print_error "$cmd not found. Please install it first."
      exit 1
    fi
  done

  # Install git-crypt if missing
  install_git_crypt || exit 1

  # Setup GPG agent
  setup_gpg_agent

  # Ask for email to associate with GPG key
  local gpg_email
  echo ""
  read -r -p "$(echo -e "${CYAN}Enter email for GPG key (used to encrypt/decrypt): ${NC}")" gpg_email
  if [[ -z "$gpg_email" ]]; then
    print_error "Email cannot be empty"
    exit 1
  fi

  # Initialize git-crypt in the repository
  if ! init_repo_encryption "$repo_dir" "$gpg_email"; then
    exit 1
  fi

  # Verify
  verify_setup "$repo_dir"

  # Show instructions
  display_instructions "$repo_dir"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi

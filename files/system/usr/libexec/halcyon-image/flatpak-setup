#!/usr/bin/env bash
# halcyon boot step — enforce the zero-flatpak policy on the system
# installation.
#
# _why_: flatpaks live in /var (machine-local), so a machine rebased from
# bazzite boots with bazzite's whole flatpak payload. Two flatpak behaviors
# make naive cleanup incomplete: (1) refs like the OBS plugins and the
# VulkanLayers are RUNTIME-type extensions — they never appear in
# `flatpak list --app`, so an app-only match never touches them; (2) refs
# installed explicitly (everything bazzite installed by name) are
# AUTO-PINNED, and pinned refs are invisible to `flatpak uninstall
# --unused`. So: match the baked list against ALL system refs, clear every
# pin, then sweep. Individual uninstalls so one failure can't abort the
# batch; no network; idempotent; user-installed APPS are never touched
# (only orphaned runtimes/extensions are swept).
set -uo pipefail

FLATPAK_IDS=(
  # apps
  com.github.Matoking.protontricks
  com.github.tchx84.Flatseal
  com.obsproject.Studio.Plugin.GStreamerVaapi
  com.obsproject.Studio.Plugin.GStreamer
  com.obsproject.Studio.Plugin.OBSVkCapture
  com.vysp3r.ProtonPlus
  io.github.DenysMb.Kontainer
  io.github.flattool.Warehouse
  org.gnome.Firmware
  org.kde.gwenview
  org.kde.haruna
  org.kde.kcalc
  org.kde.okular
  org.mozilla.firefox
  # runtime-type extensions (explicitly installed by bazzite → auto-pinned)
  org.freedesktop.Platform
  org.freedesktop.Platform.Compat.i386
  org.freedesktop.Platform.GL.default
  org.freedesktop.Platform.GL32.default
  org.freedesktop.Platform.VulkanLayer.MangoHud
  org.freedesktop.Platform.VulkanLayer.OBSVkCapture
  org.freedesktop.Platform.VulkanLayer.vkBasalt
  org.freedesktop.Platform.codecs-extra
  org.gnome.Platform
  org.kde.KStyle.Adwaita
  org.kde.Platform
)

echo "::group::flatpak-setup — enforce the removal list"

if ! command -v flatpak >/dev/null 2>&1; then
  echo "  FAIL  flatpak CLI missing" >&2
  exit 0 # opportunistic: skip rather than fail the boot unit
fi

installed_refs() {
  # NO --app: the list must include runtime-type extensions too
  flatpak list --system --columns=application 2>/dev/null || true
}

for id in "${FLATPAK_IDS[@]}"; do
  if installed_refs | grep -Fxq "${id}"; then
    if flatpak uninstall --system --noninteractive --assumeyes "${id}"; then
      echo "  OK    removed ${id}"
    else
      echo "  WARN  uninstall failed for ${id} — retried next boot" >&2
    fi
  fi
done

echo "--- clearing auto-pins (pinned refs survive --unused) ---"
while IFS= read -r ref; do
  [ -n "${ref}" ] || continue
  if flatpak pin --system --remove "${ref}" >/dev/null 2>&1; then
    echo "  OK    unpinned ${ref}"
  fi
done < <(flatpak pin --system 2>/dev/null | grep -E '^(app|runtime)/')

echo "--- sweeping orphaned runtimes/extensions ---"
if flatpak uninstall --system --unused --noninteractive --assumeyes; then
  echo "  OK    unused-runtime sweep complete (system refs left: $(flatpak list --system --columns=application | wc -l))"
else
  echo "  WARN  unused-runtime sweep failed — retried next boot" >&2
fi
echo "::endgroup::"
exit 0

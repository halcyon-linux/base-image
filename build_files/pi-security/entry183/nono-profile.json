  },
  "filesystem": {
    "read": [
      "/usr/lib64"
    ],
    "read_file": [
      "/usr/bin/bash",
      "/etc/ld.so.cache",
      "/usr/share/pi-security/entry183/probe.sh",
      "/usr/share/pi-security/entry183/allowed.txt"
    ],
    "allow": [
      "/run/pi-entry183-synthetic/work"
    ]
  },
  "workdir": {
    "access": "none"
  },
  "security": {
    "capability_elevation": false,
    "signal_mode": "isolated"
  }
}

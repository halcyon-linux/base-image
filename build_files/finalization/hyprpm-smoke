#!/usr/bin/bash

set -Eeuo pipefail

# End-to-end proof that hyprpm update works on the packaged Hyprland.
# hyprpm reads the version without a running compositor from
# `Hyprland --version-json`, git-clones that exact commit and builds the
# plugin headers with cmake + make. It refuses to run as root and elevates
# installheaders through sudo, so the flow runs as a throwaway user with a
# NOPASSWD sudoers entry; everything the test creates is removed again.
#
# The installheaders Makefile target also copies the freshly built
# hyprland.pc into /usr/share/pkgconfig when writable — that would clobber
# the packaged file with one pointing into the deleted test tree, so the
# packaged copy is backed up and restored around the run.
#
# Usage: /ctx/finalization/hyprpm-smoke
# Needs network (hyprpm clones Hyprland from GitHub).

user=hyprpm-smoke
uid=""
pc=/usr/share/pkgconfig/hyprland.pc
pc_backup=/var/tmp/hyprland.pc.packaged

cleanup() {
    rm -f /etc/sudoers.d/hyprpm-smoke
    userdel -r "$user" >/dev/null 2>&1 || true
    # uid is only set once the test user exists — never guess 0 (root)
    [[ -n "$uid" ]] && rm -rf "/run/user/$uid"
    if [[ -f "$pc_backup" ]]; then
        cp -p "$pc_backup" "$pc"
        rm -f "$pc_backup"
    fi
}
trap cleanup EXIT

if ! command -v sudo >/dev/null 2>&1; then
    echo "FAIL: sudo is not installed; hyprpm cannot elevate installheaders" >&2
    exit 1
fi

useradd -m "$user"
uid=$(id -u "$user")
echo "$user ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/hyprpm-smoke
chmod 0440 /etc/sudoers.d/hyprpm-smoke
mkdir -p "/run/user/$uid"
chown "$user:$user" "/run/user/$uid"

[[ -f "$pc" ]] && cp -p "$pc" "$pc_backup"

log=$(mktemp /var/tmp/hyprpm-smoke.XXXXXX.log)
if ! su - "$user" -c "export XDG_RUNTIME_DIR=/run/user/$uid; hyprpm update" >"$log" 2>&1; then
    echo "FAIL: hyprpm update exited non-zero; last output:" >&2
    tail -n 40 "$log" >&2
    rm -f "$log"
    exit 1
fi
tail -n 3 "$log"
rm -f "$log"

# the hyprpm state must carry both the protocol pc file and the source
# headers of the running commit
state="/home/$user/.local/share/hyprpm"
if ! find "$state" -name hyprland.pc -print -quit 2>/dev/null | grep -q .; then
    echo "FAIL: hyprpm built no hyprland.pc under $state" >&2
    exit 1
fi
if ! find "$state" -path '*/include/hyprland/*' -name version.h -print -quit 2>/dev/null | grep -q .; then
    echo "FAIL: hyprpm installed no Hyprland headers under $state" >&2
    exit 1
fi

echo "hyprpm-smoke: hyprpm update completed and plugin headers were built"

verify_services() {
    local svc
    for svc in \
        input-remapper.service uupd.timer hardware-setup.service \
        dev-hugepages1G.mount libvirtd.service ds-inhibit.service \
        greenboot-healthcheck.service greenboot-set-rollback-trigger.service \
        dmemcg-booster-system.service cardwired.service \
        sddm.service; do
        if [[ -e "/etc/systemd/system/multi-user.target.wants/$svc" || \
              -e "/etc/systemd/system/display-manager.service" || \
              -e "/etc/systemd/system/timers.target.wants/$svc" || \
              -e "/etc/systemd/system/sysinit.target.wants/$svc" ]]; then
            pass "system service enabled: $svc"
        else
            fail "system service not enabled: $svc"
        fi
    done

    for svc in chezmoi-init.service chezmoi-update.timer user-setup.service dynamic-fixes.service; do
        if [[ -e "/etc/systemd/user/default.target.wants/$svc" || \
              -e "/etc/systemd/user/timers.target.wants/$svc" ]]; then
            pass "global user service enabled: $svc"
        else
            fail "global user service not enabled: $svc"
        fi
    done

    # apply-gtk-themes.service is wanted by graphical-session.target
    if [[ -e "/etc/systemd/user/graphical-session.target.wants/apply-gtk-themes.service" ]]; then
        pass "global user service enabled: apply-gtk-themes.service"
    else
        fail "global user service not enabled: apply-gtk-themes.service"
    fi

    if [[ -e /etc/systemd/system/display-manager.service ]] || \
       [[ -e /etc/systemd/system/graphical.target.wants/sddm.service ]]; then
        pass "sddm display manager enabled"
    else
        fail "sddm display manager not enabled"
    fi

    for svc in scx_loader.service greetd.service; do
        if [[ -e "/etc/systemd/system/multi-user.target.wants/$svc" ]]; then
            fail "service should be disabled: $svc"
        else
            pass "service disabled: $svc"
        fi
    done

    # Nix daemon socket: enabled to sockets.target.wants by systemctl enable.
    if [[ -e /etc/systemd/system/sockets.target.wants/nix-daemon.socket || \
          -e /etc/systemd/system/multi-user.target.wants/nix-daemon.socket ]]; then
        pass "system service enabled: nix-daemon.socket"
    else
        fail "system service not enabled: nix-daemon.socket"
    fi

    # nix.mount enables to local-fs.target.wants.
    if [[ -e /etc/systemd/system/local-fs.target.wants/nix.mount ]]; then
        pass "system service enabled: nix.mount"
    else
        fail "system service not enabled: nix.mount"
    fi

    # var-nix.service is pulled in via RequiredBy=nix.mount — its symlink lands
    # in /etc/systemd/system/nix.mount.requires/ rather than a .wants dir.
    if [[ -e /etc/systemd/system/nix.mount.requires/var-nix.service || \
          -e /etc/systemd/system/local-fs.target.wants/var-nix.service || \
          -e /etc/systemd/system/multi-user.target.wants/var-nix.service ]]; then
        pass "system service enabled: var-nix.service"
    else
        fail "system service not enabled: var-nix.service"
    fi
}

verify_integration_files() {
    if [[ -f /etc/dxvk-example.conf ]]; then
        pass "dxvk-example.conf present"
    else
        fail "dxvk-example.conf missing"
    fi

    if [[ -f /etc/distrobox/docker.ini ]]; then

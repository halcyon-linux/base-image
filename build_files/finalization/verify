#!/usr/bin/bash

set -Eeuo pipefail

# Build-time verification for the Halcyon alcyone image (containerfile variant).
# Each group asserts the invariants of one build stage. The Containerfile
# invokes it immediately after the stage it verifies, so failures point at
# the step that broke them instead of surfacing in the final image (or worse,
# on user machines).
#
# Usage: /ctx/finalization/verify <stage>

group="${1:-}"
case "$group" in
brew | kernel | repos | cli-tools | utils | removals | common-packages | gaming | fonts | base-pkgs | hyprpm | applications | texlive-packages | nix | picker | media | desktop-integration | justfiles | services | grub | integration-files | image-info | initramfs | finalize | nvidia-config | nvidia | system-policy | nvidia-finalize | security | security-hardening | packages | final) ;;
*)
    printf 'Usage: %s <stage>\n' "$0" >&2
    exit 2
    ;;
esac

echo "::group::Executing verify (${group})"
trap 'echo "::endgroup::"' EXIT

declare -a failures=()

# Path to packages.json
PACKAGES_JSON="/ctx/packages.json"
if [[ ! -f "$PACKAGES_JSON" ]]; then
    printf 'ERROR: packages.json not found at %s\n' "$PACKAGES_JSON" >&2
    exit 1
fi

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    failures+=("$*")
}

pass() {
    printf 'OK: %s\n' "$*"
}

# Require every listed package to be installed.
require_rpms() {
    local pkg
    for pkg in "$@"; do
        if rpm -q "$pkg" >/dev/null 2>&1; then
            pass "package installed: $pkg"
        else
            fail "package missing: $pkg"
        fi
    done
}

# Require every listed package to be absent (guard rails for things this
# image must never ship).
forbid_rpms() {
    local pkg
    for pkg in "$@"; do
        if rpm -q "$pkg" >/dev/null 2>&1; then
            fail "forbidden package installed: $pkg"
        else
            pass "package absent: $pkg"
        fi
    done
}

# Load a package list from packages.json into PKG_ARRAY. A missing or empty
# list is a failure: otherwise a mistyped key would turn every check into a no-op.
load_packages() {
    local section="$1"
    local key="${2:-packages}"
    # --arg, not ".${section}": jq reads the hyphen in "cli-tools" as subtraction.
    mapfile -t PKG_ARRAY < <(jq -r --arg s "$section" --arg k "$key" '.[$s][$k][]' "$PACKAGES_JSON" 2>/dev/null)
    if [[ ${#PKG_ARRAY[@]} -eq 0 ]]; then
        fail "packages.json has no entries at .${section}.${key}"
        return 1
    fi
}

# Require packages from a JSON section
require_rpms_from_json() {
    load_packages "$@" || return 0
    require_rpms "${PKG_ARRAY[@]}"
}

# Forbid packages from a JSON section
forbid_rpms_from_json() {
    load_packages "$@" || return 0
    forbid_rpms "${PKG_ARRAY[@]}"
}

# Require every listed repo id to be known to dnf5.
require_repos() {
    local available id
    available="$(dnf5 repo info --all --json | jq -r '.[].id' || true)"
    if [[ -z "$available" ]]; then
        fail "dnf5 repo query returned nothing; cannot verify repos"
        return
    fi
    for id in "$@"; do
        if grep -qxF "$id" <<<"$available"; then
            pass "repo known: $id"
        else
            fail "repo not found: $id"
        fi
    done
}

# Require every listed repository to be present and disabled.
require_repos_disabled() {
    local available id
    available="$(dnf5 repo info --all --json)"
    for id in "$@"; do
        if jq -e --arg id "$id" \
            '[.[] | select(.id == $id)] as $repos | (($repos | length) == 1) and ($repos[0].is_enabled == false)' \
            <<<"$available" >/dev/null; then
            pass "repo disabled: $id"
        else
            fail "repo missing or still enabled: $id"
        fi
    done
}

# Require every listed package to have been installed from the given repo.
require_rpms_from_repo() {
    local repo_id="$1" pkg from
    shift
    for pkg in "$@"; do
        from="$(dnf5 info --installed "$pkg" 2>/dev/null | awk -F': ' '/^From repository/ { print $2 }' || true)"
        if [[ "$from" == "$repo_id" ]]; then
            pass "package $pkg installed from $repo_id"
        else
            fail "package $pkg resolved from '${from:-<unknown>}', expected $repo_id"
        fi
    done
}

verify_brew() {
    # The brew image ships the standalone root as a tarball; brew-setup.service
    # unpacks it into /home/linuxbrew on first boot, so the tree itself must
    # not exist at build time.
    local file
    for file in \
        /usr/share/homebrew.tar.zst \
        /etc/profile.d/brew.sh \
        /etc/profile.d/brew-bash-completion.sh \
        /etc/security/limits.d/30-brew-limits.conf \
        /usr/lib/systemd/system/brew-setup.service \
        /usr/lib/systemd/system/brew-update.service \
        /usr/lib/systemd/system/brew-update.timer \
        /usr/lib/systemd/system/brew-upgrade.service \
        /usr/lib/systemd/system/brew-upgrade.timer \
        /usr/lib/systemd/system-preset/01-homebrew.preset; do
        if [[ -f "$file" ]]; then
            pass "Homebrew file installed: $file"
        else
            fail "Homebrew file missing after install-brew-files: $file"
        fi
    done

    if [[ -d /home/linuxbrew ]]; then
        fail "/home/linuxbrew must be created by brew-setup.service, not baked into the image"
    else
        pass "/home/linuxbrew absent until first boot"
    fi
    if [[ -d /tmp/brew_files ]]; then
        fail "/tmp/brew_files staging directory was not removed"
    else
        pass "/tmp/brew_files staging directory removed"
    fi
    if [[ -e /usr/share/fish/vendor_conf.d/ublue-brew.fish ]]; then
        fail "fish brew integration present; fish shell is forbidden"
    else
        pass "fish brew integration excluded"
    fi
}

verify_kernel() {
    local -a dirs
    local kver_dir actual expected

    mapfile -t dirs < <(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
    if [[ ${#dirs[@]} -eq 1 ]]; then
        kver_dir="${dirs[0]}"
        pass "exactly one kernel modules dir: $kver_dir"
        if [[ -n "$(find "$kver_dir" -type f -print -quit)" ]]; then
            pass "kernel modules dir is populated"
        else
            fail "kernel modules dir is empty: $kver_dir"
        fi
    else
        fail "expected exactly one kernel modules dir, found ${#dirs[@]}: ${dirs[*]:-none}"
    fi

    require_rpms_from_json "kernel" "packages"

    # install-kmods only warns when its glob matches nothing, so assert the
    # module here instead of waiting for `verify final`.
    if [[ -n "$(find /usr/lib/modules -name 'nct6687*.ko*' -print -quit 2>/dev/null)" ]]; then
        pass "extra kmod present: nct6687d"
    else
        fail "required extra kmod missing: nct6687d"
    fi

    actual="$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}' 2>/dev/null || true)"
    actual="${actual%.x86_64}"
    actual="${actual%.aarch64}"
    expected="${KERNEL_VERSION:-}"
    if [[ -n "$expected" ]]; then
        if [[ "$actual" == "$expected" ]]; then
            pass "installed kernel matches KERNEL_VERSION: $actual"
        else
            fail "kernel mismatch: installed=${actual} expected=${expected}"
        fi
    else
        pass "KERNEL_VERSION not provided; skipped version comparison (installed=${actual:-unknown})"
    fi
}

verify_repos() {
    require_repos \
        fedora updates \
        fedora-multimedia \
        terra terra-extras terra-mesa \
        tailscale-stable \
        gh-cli \
        'copr:copr.fedorainfracloud.org:ublue-os:bazzite' \
        'copr:copr.fedorainfracloud.org:ublue-os:bazzite-multilib' \
        'copr:copr.fedorainfracloud.org:ublue-os:staging' \
        'copr:copr.fedorainfracloud.org:ublue-os:packages'

    # Build-time packages ship without docs; finalize removes the setting again.
    if grep -qE '^tsflags[[:space:]]*=[[:space:]]*nodocs' /etc/dnf/dnf.conf 2>/dev/null; then
        pass "dnf tsflags=nodocs set for the build"
    else
        fail "dnf tsflags=nodocs missing from /etc/dnf/dnf.conf"
    fi
}

# Every cli-tools package must come from the aahsnr-work/cli-tools COPR. Compare
# the installed package's source repo, not its vendor: the vendor string is the
# same for every aahsnr-work COPR. Terra and Fedora ship some of the same names
# and would shadow or pre-empt the COPR build.
# Mesa must be one build: every package from the mesa source RPM shares one
# EVR across x86_64 and i686 (dnf5 refuses mismatched multilib siblings) and
# one repository. install-gaming-stack picks terra-mesa and falls back to
# fedora-multimedia only when terra-mesa ships no EVR common to both arches.
# mesa-libGL-devel and mesa-libgbm-devel are part of the set: hyprpm needs them.
verify_mesa_stack() {
    require_rpms \
        mesa-filesystem mesa-dri-drivers mesa-libEGL mesa-libGL \
        mesa-libgbm mesa-vulkan-drivers mesa-libGL-devel mesa-libgbm-devel \
        mesa-filesystem.i686 mesa-dri-drivers.i686 mesa-libEGL.i686 \
        mesa-libGL.i686 mesa-libgbm.i686 mesa-vulkan-drivers.i686

    local -a mesa_pkgs=()
    local -A mesa_evrs=() mesa_repos=()
    local name evr from_repo
    mapfile -t mesa_pkgs < <(
        rpm -qa --qf '%{NAME}.%{ARCH} %{SOURCERPM}\n' | awk '$2 ~ /^mesa-[0-9]/ { print $1 }' | sort
    )
    if ((${#mesa_pkgs[@]} == 0)); then
        fail "no packages from the mesa source RPM installed"
        return 0
    fi
    while read -r name evr from_repo; do
        mesa_evrs[$evr]+=" $name"
        mesa_repos[$from_repo]+=" $name"
    done < <(dnf5 repoquery --installed --qf '%{name}.%{arch} %{epoch}:%{version}-%{release} %{from_repo}\n' "${mesa_pkgs[@]}")

    if ((${#mesa_evrs[@]} == 1)); then
        pass "Mesa packages share one EVR: ${!mesa_evrs[*]}"
    else
        for evr in "${!mesa_evrs[@]}"; do
            fail "Mesa EVR mismatch: $evr:${mesa_evrs[$evr]}"
        done
    fi

    if ((${#mesa_repos[@]} != 1)); then
        for from_repo in "${!mesa_repos[@]}"; do
            fail "Mesa packages from more than one repository: $from_repo:${mesa_repos[$from_repo]}"
        done
    else
        case "${!mesa_repos[*]}" in
            terra-mesa)
                pass "Mesa packages installed from terra-mesa"
                ;;
            fedora-multimedia)
                pass "Mesa packages installed from fedora-multimedia (terra-mesa had no EVR common to x86_64 and i686)"
                ;;
            *)
                fail "Mesa packages from '${!mesa_repos[*]}', expected terra-mesa or fedora-multimedia"
                ;;
        esac
    fi
}

verify_cli_tools_source() {
    local repo_id name from_repo pkg
    local -A source_repo=()
    repo_id=$(jq -r '."cli-tools".repo_id' "$PACKAGES_JSON")
    load_packages "cli-tools" "packages" || return 0
    while read -r name from_repo; do
        source_repo[$name]="$from_repo"
    done < <(dnf5 repoquery --installed --qf '%{name} %{from_repo}\n' "${PKG_ARRAY[@]}")
    for pkg in "${PKG_ARRAY[@]}"; do
        if [[ "${source_repo[$pkg]:-}" == "$repo_id" ]]; then
            pass "cli-tools package installed from the COPR: $pkg"
        else
            fail "cli-tools package not from $repo_id: $pkg (${source_repo[$pkg]:-not installed})"
        fi
    done
}

verify_cli_tools() {
    require_rpms_from_json "cli-tools" "packages"

    require_repos_disabled 'copr:copr.fedorainfracloud.org:aahsnr-work:cli-tools'

    local bin
    for bin in bun uv eza bat zoxide fzf starship zellij; do
        if [[ -x "/usr/bin/$bin" ]]; then
            pass "CLI binary present and executable: /usr/bin/$bin"
        else
            fail "CLI binary missing or not executable: /usr/bin/$bin"
        fi
    done

    # Terra ships a newer fzy and the base image ships fzf: both must still be
    # the COPR builds, as must every other package in the list.
    verify_cli_tools_source
}


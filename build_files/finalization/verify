verify_common_packages() {
    require_rpms_from_json "common-packages" "packages"

    # Fedora ships the curses variant inside the `pinentry` package (it only
    # Provides pinentry-curses), so assert the executables the wrapper needs.
    for pinentry_bin in /usr/bin/pinentry-curses /usr/bin/pinentry-gnome3 /usr/bin/pinentry-tty; do
        if [[ -x "$pinentry_bin" ]]; then
            pass "pinentry binary present and executable: $pinentry_bin"
        else
            fail "pinentry binary missing or not executable: $pinentry_bin"
        fi
    done

    require_repos_disabled 'copr:copr.fedorainfracloud.org:bieszczaders:kernel-cachyos-addons'

    forbid_rpms fish greetd greetd-selinux zsh-autosuggestions zsh-syntax-highlighting

    local extra_zsh
    extra_zsh=$(rpm -qa --qf '%{NAME}\n' 'zsh*' 2>/dev/null | grep -v '^zsh$' || true)
    if [[ -n "$extra_zsh" ]]; then
        fail "Forbidden auxiliary zsh package(s) installed: $extra_zsh"
    else
        pass "Only standalone zsh package is installed"
    fi

    local bin
    for bin in /usr/bin/chezmoi /usr/bin/sddm /usr/bin/rmmod /usr/bin/modprobe; do
        if [[ -x "$bin" ]]; then
            pass "binary present and executable: $bin"
        else
            fail "binary missing or not executable: $bin"
        fi
    done

    if [[ -f /usr/lib/extest/libextest.so ]]; then
        pass "extest library present: /usr/lib/extest/libextest.so"
    else
        fail "extest library missing: /usr/lib/extest/libextest.so"
    fi

    if [[ -L /etc/NetworkManager/dispatcher.d/04-iscsi && "$(readlink /etc/NetworkManager/dispatcher.d/04-iscsi)" == "/dev/null" ]]; then
        pass "iscsi dispatcher script masked to /dev/null"
    else
        fail "iscsi dispatcher script not masked to /dev/null"
    fi
}

verify_gaming() {
    require_rpms_from_json "gaming" "packages"

    require_repos_disabled 'copr:copr.fedorainfracloud.org:aahsnr-work:gaming'

    forbid_rpms_from_json "gaming" "removals"

    if [[ -x /usr/bin/winetricks ]]; then
        pass "winetricks present and executable: /usr/bin/winetricks"
    else
        fail "winetricks missing or not executable: /usr/bin/winetricks"
    fi

    if [[ -x /usr/bin/protonplus ]]; then
        pass "protonplus present and executable: /usr/bin/protonplus"
    else
        fail "protonplus missing or not executable: /usr/bin/protonplus"
    fi

    local locks
    locks="$(dnf5 versionlock list 2>/dev/null || true)"
    local locked_pkg
    if load_packages "gaming" "versionlocks"; then
        for locked_pkg in "${PKG_ARRAY[@]}"; do
            if grep -qF "$locked_pkg" <<<"$locks"; then
                pass "versionlock active for: $locked_pkg"
            else
                fail "versionlock missing for: $locked_pkg"
            fi
        done
    fi

    # The bazzite-multilib swap must have landed: the versionlock pins whatever
    # is installed, so it proves nothing on its own. These packages are only
    # useful in their patched bazzite build.
    local swapped_pkg swapped_evr
    for swapped_pkg in xorg-x11-server-Xwayland bluez; do
        swapped_evr="$(rpm -q --qf '%{VERSION}-%{RELEASE}' "$swapped_pkg" 2>/dev/null || true)"
        if [[ "$swapped_evr" == *bazzite* ]]; then
            pass "patched bazzite build installed: ${swapped_pkg}-${swapped_evr}"
        else
            fail "${swapped_pkg} is not the patched bazzite build (${swapped_evr:-not installed})"
        fi
    done

    verify_mesa_stack
}


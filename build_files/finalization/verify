        brew-setup.service input-remapper.service uupd.timer hardware-setup.service \
        dev-hugepages1G.mount libvirtd.service ds-inhibit.service \
        greenboot-healthcheck.service greenboot-set-rollback-trigger.service \
        dmemcg-booster-system.service cardwired.service system-flatpak-setup.service \
        sddm.service; do
        if [[ -e "/etc/systemd/system/multi-user.target.wants/$svc" || \
              -e "/etc/systemd/system/display-manager.service" || \
              -e "/etc/systemd/system/timers.target.wants/$svc" || \
              -e "/etc/systemd/system/sysinit.target.wants/$svc" ]]; then
            pass "system service enabled: $svc"
        else
            fail "system service not enabled: $svc"
        fi
    done

    for svc in chezmoi-init.service chezmoi-update.timer user-setup.service dynamic-fixes.service; do
        if [[ -e "/etc/systemd/user/default.target.wants/$svc" || \
              -e "/etc/systemd/user/timers.target.wants/$svc" ]]; then
            pass "global user service enabled: $svc"
        else
            fail "global user service not enabled: $svc"
        fi
    done

    if [[ -e /etc/systemd/system/display-manager.service ]] || \
       [[ -e /etc/systemd/system/graphical.target.wants/sddm.service ]]; then
        pass "sddm display manager enabled"
    else
        fail "sddm display manager not enabled"
    fi

    for svc in scx_loader.service greetd.service; do
        if [[ -e "/etc/systemd/system/multi-user.target.wants/$svc" ]]; then
            fail "service should be disabled: $svc"
        else
            pass "service disabled: $svc"
        fi
    done
}


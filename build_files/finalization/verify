}

verify_texlive_packages() {
    require_rpms_from_json "texlive-packages" "packages"

    require_repos_disabled 'copr:copr.fedorainfracloud.org:aahsnr-work:texlive-packages'

    # The COPR packages carry no %post scriptlets, so the image bakes the
    # formats itself: without them pdflatex/lualatex abort with "I can't find
    # the format file".
    local tl_root tl_formats
    tl_root="$(find /usr/lib/texlive -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -V | tail -n1)"
    if [[ -n "$tl_root" && -d "${tl_root}/bin/x86_64-linux" && -d "${tl_root}/texmf-dist/web2c" ]]; then
        pass "TeX Live tree present: ${tl_root}"
    else
        fail "no usable TeX Live tree under /usr/lib/texlive (found: ${tl_root:-none})"
        return
    fi

    if [[ -f "${tl_root}/texmf-dist/ls-R" ]]; then
        pass "kpathsea filename database present: ${tl_root}/texmf-dist/ls-R"
    else
        fail "kpathsea filename database missing: ${tl_root}/texmf-dist/ls-R"
    fi

    tl_formats="$(find "${tl_root}/texmf-var/web2c" -name '*.fmt' -size +0 2>/dev/null | wc -l)"
    if [[ "${tl_formats}" -gt 0 ]]; then
        pass "TeX Live formats baked: ${tl_formats}"
    else
        fail "no TeX Live formats baked under ${tl_root}/texmf-var/web2c"
    fi


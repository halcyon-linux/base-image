verify_image_info() {
    local info=/usr/share/ublue-os/image-info.json
    if [[ -f "$info" ]] && jq -e '(."image-name" | strings | length > 0) and (."image-branch" | strings | length > 0) and (."image-ref" | strings | length > 0)' "$info" >/dev/null; then
        pass "image-info.json populated: $info"
    else
        fail "image-info.json missing or incomplete: $info"
    fi
    if jq -e '."image-ref" | startswith("ostree-image-signed:docker://ghcr.io/")' "$info" >/dev/null 2>&1; then
        pass "image-ref uses the signed ghcr.io scheme"
    else
        fail "image-ref must start with ostree-image-signed:docker://ghcr.io/: $(jq -r '."image-ref"' "$info" 2>/dev/null || echo missing)"
    fi
}

verify_initramfs() {
    local -a imgs
    mapfile -t imgs < <(find /usr/lib/modules -name 'initramfs.img' 2>/dev/null)
    if [[ ${#imgs[@]} -ge 1 ]]; then
        local img="${imgs[0]}"
        local size
        size=$(stat -c '%s' "$img" 2>/dev/null || echo 0)
        if ((size > 1000000)); then
            pass "initramfs image present and non-empty ($size bytes): $img"
        else
            fail "initramfs image too small ($size bytes): $img"
        fi
    else
        fail "initramfs.img not found under /usr/lib/modules"
    fi
}

verify_finalize() {
    local lockfile
    for lockfile in /etc/.pwd.lock /etc/passwd- /etc/group- /etc/shadow- /etc/gshadow- /etc/subuid- /etc/subgid-; do
        if [[ -e "$lockfile" ]]; then
            fail "transient lock or backup file present: $lockfile"
        else
            pass "transient lock/backup absent: $lockfile"
        fi
    done

    if [[ -f /usr/lib/passwd && -f /usr/lib/group ]]; then
        pass "system account databases exist in /usr/lib"
    else
        fail "system account databases missing from /usr/lib"
    fi
}


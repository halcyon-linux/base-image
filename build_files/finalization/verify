verify_applications() {
    require_rpms_from_json "applications" "copr_packages"
    require_rpms_from_json "applications" "fedora_packages"

    # External repo packages
    local ext_repo_count
    ext_repo_count=$(jq '.["applications"].external_repos | length' "$PACKAGES_JSON")
    for ((i=0; i<ext_repo_count; i++)); do
        mapfile -t repo_packages < <(jq -r ".applications.external_repos[$i].packages[]" "$PACKAGES_JSON")
        for pkg in "${repo_packages[@]}"; do
            if rpm -q "$pkg" >/dev/null 2>&1; then
                pass "package installed: $pkg"
            else
                fail "package missing: $pkg"
            fi
        done
    done

    require_repos_disabled \
        'copr:copr.fedorainfracloud.org:aahsnr-work:applications' \
        'code' \
        'gitlab.com_paulcarroty_vscodium_repo' \
        'brave-browser' \
        'google-chrome' \
        'microsoft-edge' \
        'vivaldi'

    if [[ -x /usr/bin/beesd ]]; then
        pass "beesd binary present and executable: /usr/bin/beesd"
    else
        fail "beesd binary missing or not executable: /usr/bin/beesd"
    fi

    local app_bin
    for app_bin in \
        /usr/bin/code \
        /usr/bin/codium \
        /usr/bin/brave-browser \
        /usr/bin/firefox \
        /usr/bin/google-chrome \
        /usr/bin/microsoft-edge \
        /usr/bin/vivaldi; do
        if [[ -x "$app_bin" ]]; then
            pass "application binary present and executable: $app_bin"
        else
            fail "application binary missing or not executable: $app_bin"
        fi
    done

    if [[ -f /usr/lib/systemd/system/beesd@.service ]]; then
        pass "beesd@.service unit present: /usr/lib/systemd/system/beesd@.service"
    else
        fail "beesd@.service unit missing: /usr/lib/systemd/system/beesd@.service"
    fi

    if [[ -d /opt && ! -L /opt ]]; then
        pass "/opt is a real directory"
    else
        fail "/opt is missing or a symlink"
    fi
}

verify_texlive_packages() {
    require_rpms_from_json "texlive-packages" "packages"

    require_repos_disabled 'copr:copr.fedorainfracloud.org:aahsnr-work:texlive-packages'

    # The COPR packages carry no %post scriptlets, so the image bakes the
    # formats itself: without them pdflatex/lualatex abort with "I can't find
    # the format file".
    local tl_root tl_formats
    tl_root="$(find /usr/lib/texlive -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -V | tail -n1)"
    if [[ -n "$tl_root" && -d "${tl_root}/bin/x86_64-linux" && -d "${tl_root}/texmf-dist/web2c" ]]; then
        pass "TeX Live tree present: ${tl_root}"
    else
        fail "no usable TeX Live tree under /usr/lib/texlive (found: ${tl_root:-none})"
        return
    fi

    if [[ -f "${tl_root}/texmf-dist/ls-R" ]]; then
        pass "kpathsea filename database present: ${tl_root}/texmf-dist/ls-R"
    else
        fail "kpathsea filename database missing: ${tl_root}/texmf-dist/ls-R"
    fi

    tl_formats="$(find "${tl_root}/texmf-var/web2c" -name '*.fmt' -size +0 2>/dev/null | wc -l)"
    if [[ "${tl_formats}" -gt 0 ]]; then
        pass "TeX Live formats baked: ${tl_formats}"
    else
        fail "no TeX Live formats baked under ${tl_root}/texmf-var/web2c"
    fi

    if find "${tl_root}/texmf-var/web2c" -name 'pdflatex.fmt' -size +0 -print -quit 2>/dev/null | grep -q .; then
        pass "pdflatex format baked"
    else
        fail "pdflatex format missing"
    fi

    if find "${tl_root}/texmf-var/web2c" -name 'lualatex.fmt' -size +0 -print -quit 2>/dev/null | grep -q .; then
        pass "lualatex format baked"
    else
        fail "lualatex format missing"
    fi
}


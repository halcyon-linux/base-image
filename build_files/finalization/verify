verify_desktop_integration() {
    local perm
    perm="$(stat -c '%a' /var/tmp 2>/dev/null || true)"
    if [[ "$perm" == "1777" ]]; then
        pass "/var/tmp permissions are 1777"
    else
        fail "/var/tmp permissions are $perm, expected 1777"
    fi

    if [[ -e /usr/lib/libdrm.so && -e /usr/lib64/libdrm.so ]]; then
        pass "DRM library symlinks present"
    else
        fail "DRM library symlink missing (/usr/lib[64]/libdrm.so)"
    fi

    local app
    for app in nvtop btop yad-icon-browser; do
        if [[ -f "/usr/share/applications/${app}.desktop" ]]; then
            if grep -q '^Hidden=true' "/usr/share/applications/${app}.desktop"; then
                pass "application hidden from menus: $app"
            else
                fail "application not hidden: $app"
            fi
        fi
    done

    if [[ -f /etc/bluetooth/input.conf ]] && grep -q '^UserspaceHID=true' /etc/bluetooth/input.conf; then
        pass "UserspaceHID enabled in /etc/bluetooth/input.conf"
    else
        fail "UserspaceHID not enabled in /etc/bluetooth/input.conf"
    fi

    local autostart_path
    for autostart_path in \
        /etc/skel/.config/autostart/steam.desktop \
        /etc/xdg/autostart/steam.desktop \
        /usr/share/autostart/steam.desktop; do
        if [[ -e "$autostart_path" ]]; then
            fail "Steam autostart entry present: $autostart_path"
        else
            pass "Steam autostart entry absent: $autostart_path"
        fi
    done

    if grep -qxF '/usr/bin/zsh' /etc/shells 2>/dev/null; then
        pass "zsh present in /etc/shells"
    else
        fail "zsh missing from /etc/shells"
    fi
    if grep -qP '^root:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:/usr/bin/zsh$' /etc/passwd 2>/dev/null; then
        pass "root shell is /usr/bin/zsh"
    else
        fail "root shell is not /usr/bin/zsh"
    fi
    if [[ -f /etc/skel/.zshrc ]]; then
        pass "/etc/skel/.zshrc is present"
    else
        fail "/etc/skel/.zshrc is missing"
    fi
    if [[ -f /usr/share/zsh/site-functions/zsh-preexec.zsh ]]; then
        pass "zsh-preexec shim present: /usr/share/zsh/site-functions/zsh-preexec.zsh"
    else
        fail "zsh-preexec shim missing: /usr/share/zsh/site-functions/zsh-preexec.zsh"
    fi
    if grep -qE 'zsh-autosuggestions|zsh-syntax-highlighting' /etc/skel/.zshrc 2>/dev/null; then
        fail "/etc/skel/.zshrc references forbidden auxiliary zsh packages"
    else
        pass "/etc/skel/.zshrc contains no auxiliary zsh package references"
    fi

    if [[ -e /etc/profile.d/toolbox.sh ]]; then
        fail "/etc/profile.d/toolbox.sh present (must be removed)"
    else
        pass "/etc/profile.d/toolbox.sh absent"
    fi
}


verify_final() {
    local info kver

    # The GRUB menu must still be visible in the published image.
    verify_grub

    require_repos_disabled \
        'copr:copr.fedorainfracloud.org:aahsnr-work:cli-tools' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:python-packages' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:gaming' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:fonts' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:base-pkgs' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:applications' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:texlive-packages' \
        'code' \
        'gitlab.com_paulcarroty_vscodium_repo' \
        'brave-browser' \
        'google-chrome' \
        'microsoft-edge' \
        'vivaldi' \
        'gh-cli'

    # Negative guards: fonts and waydroid must never reach the published image.
    forbid_rpms \
        nerd-fonts fira-code-fonts lato-fonts google-noto-sans-cjk-fonts twitter-twemoji-fonts \
        google-roboto-fonts google-roboto-mono-fonts \
        waydroid waydroid-nvidia obs-studio-plugin-vkcapture-hook-libs \
        jupiter-fan-control jupiter-hw-support-btrfs jupiter-sd-mounting-btrfs \
        steamdeck-dsp steamdeck-backgrounds steamdeck-gnome-presets steamdeck-kde-presets \
        inputplumber steamos-manager-powerstation steamos-manager \
        gamescope-session-ogui-steam powerbuttond vpower sdgyrodsu galileo-mura \
        pinentry-qt

    # Device-specific trim: kernel modules for absent hardware must not reappear.
    forbid_rpms \
        kmod-zenergy kmod-ryzen_smu kmod-wl kmod-openrazer kmod-xone kmod-gcadapter_oc \
        kmod-evdi kmod-kvmfr kmod-new-lg4ff kmod-hid-tmff2 kmod-t150-driver \
        kmod-hid-fanatecff kmod-sc0710 kmod-system76-driver kmod-system76-io kmod-v4l2loopback

    # The offline docs bundle was removed on purpose (it was the only carrier
    # of the Roboto/Roboto Mono webfonts).
    if [[ -e /usr/share/ublue-os/docs ]]; then
        fail "offline docs bundle present: /usr/share/ublue-os/docs"
    else
        pass "offline docs bundle absent"
    fi

    # Ensure Steam does not autostart on user login.
    local autostart_path
    for autostart_path in \
        /etc/skel/.config/autostart/steam.desktop \
        /etc/xdg/autostart/steam.desktop \
        /usr/share/autostart/steam.desktop; do
        if [[ -e "$autostart_path" ]]; then
            fail "Steam autostart entry present: $autostart_path"
        else
            pass "Steam autostart entry absent: $autostart_path"
        fi
    done

    # zsh must be the default login shell.
    if grep -qxF '/usr/bin/zsh' /etc/shells 2>/dev/null; then
        pass "zsh present in /etc/shells"
    else
        fail "zsh missing from /etc/shells"
    fi
    if grep -qP '^root:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:/usr/bin/zsh$' /etc/passwd 2>/dev/null; then
        pass "root shell is /usr/bin/zsh"
    else
        fail "root shell is not /usr/bin/zsh"
    fi
    if [[ -f /etc/skel/.zshrc ]]; then
        pass "/etc/skel/.zshrc is present"
    else
        fail "/etc/skel/.zshrc is missing"
    fi
    if [[ -x /usr/bin/pinentry-wrapper ]]; then
        pass "pinentry-wrapper present and executable: /usr/bin/pinentry-wrapper"
    else
        fail "pinentry-wrapper missing or not executable: /usr/bin/pinentry-wrapper"
    fi
    if [[ -f /etc/skel/.gnupg/gpg-agent.conf ]]; then
        pass "gpg-agent.conf present: /etc/skel/.gnupg/gpg-agent.conf"
    else
        fail "gpg-agent.conf missing: /etc/skel/.gnupg/gpg-agent.conf"
    fi
    if [[ -f /usr/share/zsh/site-functions/zsh-preexec.zsh ]]; then
        pass "zsh-preexec shim present: /usr/share/zsh/site-functions/zsh-preexec.zsh"
    else
        fail "zsh-preexec shim missing: /usr/share/zsh/site-functions/zsh-preexec.zsh"
    fi
    # /etc/skel/.zshrc must not reference auxiliary zsh packages that are not installed.
    if grep -qE 'zsh-autosuggestions|zsh-syntax-highlighting' /etc/skel/.zshrc 2>/dev/null; then
        fail "/etc/skel/.zshrc references forbidden auxiliary zsh packages"
    else
        pass "/etc/skel/.zshrc contains no auxiliary zsh package references"
    fi

    # SDDM must be the display manager; greetd must be absent.
    if [[ -e /usr/lib/systemd/system/sddm.service ]]; then
        pass "sddm.service unit present"
    else
        fail "sddm.service unit missing"
    fi
    if [[ -e /etc/systemd/system/display-manager.service ]] || \
       [[ -e /etc/systemd/system/graphical.target.wants/sddm.service ]]; then
        pass "sddm.service is enabled as display manager"
    else
        fail "sddm.service is not enabled as display manager"
    fi
    for greetd_path in /usr/bin/greetd /etc/greetd /usr/lib/systemd/system/greetd.service; do
        if [[ -e "$greetd_path" ]]; then
            fail "greetd artifact present (must be absent): $greetd_path"
        else
            pass "greetd artifact absent: $greetd_path"
        fi
    done

    info=/usr/share/ublue-os/image-info.json
    if [[ -f "$info" ]] && jq -e '(."image-name" | strings | length > 0) and (."image-branch" | strings | length > 0) and (."image-ref" | strings | length > 0)' "$info" >/dev/null; then
        pass "image-info.json populated: $info"
    else
        fail "image-info.json missing or incomplete: $info"
    fi
    if jq -e '."image-ref" | startswith("ostree-image-signed:docker://ghcr.io/")' "$info" >/dev/null 2>&1; then
        pass "image-ref uses the signed ghcr.io scheme"
    else
        fail "image-ref must start with ostree-image-signed:docker://ghcr.io/: $(jq -r '."image-ref"' "$info" 2>/dev/null || echo missing)"
    fi

    kver="$(dnf5 repoquery --installed --queryformat='%{evr}.%{arch}' kernel 2>/dev/null | head -n1 || true)"
    if [[ -z "$kver" ]]; then
        kver="$(rpm -q kernel-core --qf '%{evr}.%{arch}\n' 2>/dev/null | head -n1 || true)"
    fi
    if [[ -n "$kver" && -d "/usr/lib/modules/$kver" ]]; then
        pass "installed kernel has matching modules dir: /usr/lib/modules/$kver"
    else
        fail "kernel modules dir mismatch: kernel=${kver:-none}"
    fi

    local -a modprobe_dirs
    mapfile -t modprobe_dirs < <(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
    if [[ ${#modprobe_dirs[@]} -eq 1 ]]; then
        pass "single kernel tree retained in final image: ${modprobe_dirs[0]}"
    else
        fail "expected single kernel tree, found ${#modprobe_dirs[@]}: ${modprobe_dirs[*]:-none}"
    fi

    local kernel_flavor
    kernel_flavor="$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}' 2>/dev/null || true)"
    if [[ "$kernel_flavor" == *fsync* || "$kernel_flavor" == *ogc* ]]; then
        pass "gaming kernel retained: $kernel_flavor"
    else
        fail "gaming kernel missing from final image (found: ${kernel_flavor:-none})"
    fi

    if [[ -n "$(find /usr/lib/modules -name 'nct6687*.ko*' -print -quit 2>/dev/null)" ]]; then
        pass "extra kmod present: nct6687d"
    else
        fail "required extra kmod missing: nct6687d"
    fi

    # The graphics stack must survive the whole build: Mesa comes from Terra
    # (Fedora's Mesa is excluded) and must still be present next to the
    # NVIDIA driver in the published image.
    require_rpms \
        mesa-filesystem mesa-dri-drivers mesa-libEGL mesa-libGL \
        mesa-libgbm mesa-vulkan-drivers

    if [[ -n "$(find /usr/lib/modules -name 'nvidia.ko*' -print -quit 2>/dev/null)" ]]; then
        pass "nvidia kmod present"
    else
        fail "nvidia kmod missing from final image"
    fi

    local required_binary
    for required_binary in \
        /usr/bin/ujust /usr/bin/ujust-picker /usr/bin/bruh \
        /usr/bin/hardware-setup /usr/bin/user-setup /usr/bin/dynamic-fixes \
        /usr/bin/ublue-motd /usr/bin/uupd-update /usr/bin/dlss-swapper \
        /usr/bin/steam /usr/bin/lutris /usr/bin/protonplus /usr/bin/winetricks \
        /usr/bin/bazaar /usr/bin/uupd /usr/bin/fastfetch /usr/bin/btop \
        /usr/bin/input-remapper-control /usr/bin/snapper /usr/bin/btrfs-assistant \
        /usr/bin/virt-manager /usr/bin/chezmoi /usr/bin/flatpak /usr/bin/sddm \
        /usr/bin/code /usr/bin/codium /usr/bin/brave-browser /usr/bin/firefox \
        /usr/bin/google-chrome /usr/bin/microsoft-edge /usr/bin/vivaldi \
        /usr/bin/nvim /usr/bin/kitty \
        /usr/bin/pinentry-wrapper \
        /usr/bin/g++ /usr/bin/meson /usr/bin/cpio; do
        if [[ -x "$required_binary" ]]; then
            pass "command present and executable: $required_binary"
        else
            fail "command missing or not executable: $required_binary"
        fi
    done

    if [[ -d /usr/share/icons/Papirus ]]; then
        pass "Papirus icon theme installed"
    else
        fail "Papirus icon theme missing"
    fi

    local unit
    for unit in \
        /usr/lib/systemd/system/hardware-setup.service \
        /usr/lib/systemd/system/greenboot-healthcheck.service \
        /usr/lib/systemd/system/greenboot-set-rollback-trigger.service \
        /usr/lib/systemd/system/dmemcg-booster-system.service \
        /usr/lib/systemd/system/uupd.timer \
        /usr/lib/systemd/system/sddm.service \
        /usr/lib/systemd/system/var-nix.service \
        /usr/lib/systemd/system/nix.mount \
        /usr/lib/systemd/system/nix-daemon.service \
        /usr/lib/systemd/system/nix-daemon.socket \
        /usr/lib/tmpfiles.d/nix.conf \
        /etc/profile.d/00-nix-resolve-home-env.sh \
        /etc/nix/nix.conf \
        /usr/lib/systemd/user/user-setup.service \
        /usr/lib/systemd/user/dynamic-fixes.service \
        /usr/lib/systemd/user/dmemcg-booster-user.service \
        /usr/lib/systemd/user/chezmoi-init.service \
        /usr/lib/systemd/user/chezmoi-update.timer \
        /usr/lib/systemd/user/apply-gtk-themes.service; do
        if [[ -e "$unit" ]]; then
            pass "unit file present: $unit"
        else
            fail "unit file missing: $unit"
        fi
    done

    for unit in \
        /usr/lib/systemd/system/bazzite-hardware-setup.service \
        /usr/lib/systemd/system/bazzite-iwd-migration.service \
        /usr/lib/systemd/system/bazzite-libvirtd-setup.service \
        /usr/lib/systemd/system/force-wol.service \
        /usr/lib/systemd/system/incus-workaround.service \
        /usr/lib/systemd/system/greetd.service \
        /usr/lib/systemd/user/ntfs-nag.service; do
        if [[ -e "$unit" ]]; then
            fail "obsolete/removed unit file present: $unit"
        else
            pass "obsolete/removed unit file absent: $unit"
        fi
    done

    if [[ -e /usr/lib/systemd/system/service.d/50-keep-warm.conf ]]; then
        fail "keep-warm systemd drop-in present: /usr/lib/systemd/system/service.d/50-keep-warm.conf"
    else
        pass "keep-warm systemd drop-in absent"
    fi

    if [[ -d /usr/share/ublue-os/bazaar ]]; then
        pass "bazaar software directory present: /usr/share/ublue-os/bazaar"
    else
        fail "bazaar software directory missing: /usr/share/ublue-os/bazaar"
    fi

    if [[ -L /etc/bazaar/bazaar.yaml && "$(readlink /etc/bazaar/bazaar.yaml)" == "/usr/share/ublue-os/bazaar/main.yaml" && \
          -L /etc/bazaar/config.yaml && "$(readlink /etc/bazaar/config.yaml)" == "/usr/share/ublue-os/bazaar/content.yaml" ]]; then
        pass "bazaar configuration symlinks present in /etc/bazaar"
    else
        fail "bazaar configuration symlinks missing or misdirected in /etc/bazaar"
    fi

    if grep -q '<allow_any>yes</allow_any>' \
        /usr/share/polkit-1/actions/org.bazzite.privileged.user.setup.policy 2>/dev/null; then
        fail "polkit action insecurely defaults allow_any to yes"
    else
        pass "polkit action has secure defaults"
    fi

    # chezmoi user units and global enablement
    local chezmoi_unit
    for chezmoi_unit in \
        /usr/lib/systemd/user/chezmoi-init.service \
        /usr/lib/systemd/user/chezmoi-update.service \
        /usr/lib/systemd/user/chezmoi-update.timer; do
        if [[ -e "$chezmoi_unit" ]]; then
            pass "chezmoi unit present: $chezmoi_unit"
        else
            fail "chezmoi unit missing: $chezmoi_unit"
        fi
    done

    for chezmoi_unit in \
        /etc/systemd/user/default.target.wants/chezmoi-init.service \
        /etc/systemd/user/timers.target.wants/chezmoi-update.timer; do
        if [[ -e "$chezmoi_unit" ]]; then
            pass "chezmoi unit enabled: $chezmoi_unit"
        else
            fail "chezmoi unit not enabled: $chezmoi_unit"
        fi
    done

    if grep -qF 'aahsnr-configs/dotfiles' /usr/lib/systemd/user/chezmoi-init.service 2>/dev/null && \
       grep -qF -- '--force' /usr/lib/systemd/user/chezmoi-init.service 2>/dev/null && \
       grep -qF 'pushInsteadOf' /usr/lib/systemd/user/chezmoi-init.service 2>/dev/null && \
       grep -qF 'core.sshCommand' /usr/lib/systemd/user/chezmoi-init.service 2>/dev/null; then
        pass "chezmoi-init clones aahsnr-configs/dotfiles anonymously (HTTPS) and pins SSH pushes"
    else
        fail "chezmoi-init does not pin the HTTPS-pull / SSH-push policy for aahsnr-configs/dotfiles"
    fi

    if [[ -f /etc/ssh/ssh_config.d/10-halcyon-github.conf ]] && \
       grep -qF 'Host github.com' /etc/ssh/ssh_config.d/10-halcyon-github.conf 2>/dev/null && \
       grep -qF 'id_ed25519_aahsnr_configs' /etc/ssh/ssh_config.d/10-halcyon-github.conf 2>/dev/null; then
        pass "system-wide default github.com SSH identity present"
    else
        fail "system-wide default github.com SSH identity missing or wrong key"
    fi

    if grep -qF -- '--no-tty --force' /usr/lib/systemd/user/chezmoi-update.service 2>/dev/null; then
        pass "chezmoi-update targets non-interactive update with --force"
    else
        fail "chezmoi-update missing --no-tty --force"
    fi

    # Flatpak policy: no applications provisioned, system Flathub remote only,
    # Bazaar (dnf) is the software center.
    if [[ -f /etc/flatpak/remotes.d/flathub.flatpakrepo ]] && grep -qF 'https://dl.flathub.org/repo/' /etc/flatpak/remotes.d/flathub.flatpakrepo 2>/dev/null; then
        pass "flathub.flatpakrepo remote definition present"
    else
        fail "flathub.flatpakrepo missing or invalid"
    fi

    local extraflatremote
    extraflatremote=$(find /etc/flatpak/remotes.d -maxdepth 1 -type f ! -name flathub.flatpakrepo 2>/dev/null || true)
    if [[ -n "$extraflatremote" ]]; then
        fail "unexpected remote definitions in /etc/flatpak/remotes.d (only flathub is allowed): $extraflatremote"
    else
        pass "/etc/flatpak/remotes.d declares only flathub"
    fi

    if [[ -d /usr/share/flatpak/remotes.d ]]; then
        extraflatremote=$(find /usr/share/flatpak/remotes.d -maxdepth 1 -type f ! -name flathub.flatpakrepo 2>/dev/null || true)
        if [[ -n "$extraflatremote" ]]; then
            fail "unexpected remote definitions in /usr/share/flatpak/remotes.d (only flathub is allowed): $extraflatremote"
        else
            pass "/usr/share/flatpak/remotes.d declares only flathub"
        fi
    fi

    local flatpak_artifact
    for flatpak_artifact in \
        /usr/share/ublue-os/flatpak/system-flatpaks.list \
        /usr/libexec/system-flatpak-setup \
        /usr/lib/systemd/system/system-flatpak-setup.service \
        /etc/systemd/system/multi-user.target.wants/system-flatpak-setup.service; do
        if [[ -e "$flatpak_artifact" ]]; then
            fail "removed flatpak provisioning artifact present: $flatpak_artifact"
        else
            pass "flatpak provisioning artifact absent: $flatpak_artifact"
        fi
    done

    local system_flatpaks
    if system_flatpaks=$(flatpak list --system --app --columns=application 2>/dev/null || true) && [[ -n "$system_flatpaks" ]]; then
        fail "system flatpak applications installed by default: $system_flatpaks"
    else
        pass "no system flatpak applications installed"
    fi

    require_rpms bazaar flatpak

    # /opt directory layout: must be an immutable directory in root, not a symlink to /var/opt
    if [[ -d /opt && ! -L /opt ]]; then
        pass "/opt is a real directory in final image"
    else
        fail "/opt is missing or a symlink in final image"
    fi
}

case "$group" in

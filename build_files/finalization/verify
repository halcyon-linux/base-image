verify_hyprpm() {
    require_rpms hyprland hyprland-devel

    # hyprpm build-time header compilation dependencies
    require_rpms \
        lcms2-devel \
        libXcursor-devel \
        libeis-devel \
        libuuid-devel \
        mesa-libgbm-devel \
        muParser-devel \
        pango-devel \
        re2-devel \
        wayland-protocols-devel

    # hyprpm checks these via command -v before doing anything (cpio, cmake,
    # pkg-config, gcc, g++, git, hyprwayland-scanner); make is what its installheaders step runs,
    # meson is what most plugin repositories build with, and sudo is what it
    # elevates installheaders through.
    local bin
    for bin in hyprpm hyprctl cpio cmake pkg-config gcc g++ git make meson sudo hyprwayland-scanner; do
        if command -v "$bin" >/dev/null 2>&1; then
            pass "hyprpm dependency on PATH: $bin"
        else
            fail "hyprpm dependency missing: $bin"
        fi
    done

    # hyprpm locates the packaged headers through the hyprland.pc file
    if pkgconf --modversion hyprland >/dev/null 2>&1; then
        pass "hyprland.pc resolves: $(pkgconf --modversion hyprland)"
    else
        fail "pkgconf cannot resolve the hyprland module (hyprland.pc broken?)"
    fi

    local pc_mod
    for pc_mod in uuid "wayland-protocols >= 1.49" pango pangocairo xcursor libeis-1.0 gbm re2 muparser lcms2; do
        if pkgconf --exists "$pc_mod" >/dev/null 2>&1; then
            pass "hyprpm dependency pkgconfig resolves: $pc_mod"
        else
            fail "pkgconf cannot resolve hyprpm dependency: $pc_mod"
        fi
    done

    # hyprpm update git-clones and checks out the exact commit the binary
    # was built from.  The installed headers ship version.h with the
    # authoritative GIT_COMMIT_HASH — the same value hyprpm itself reads
    # to decide which source tree to check out.  Reading the header is
    # reliable in a headless container where the Hyprland binary may refuse
    # to run (missing XDG_RUNTIME_DIR, root checks, GPU drivers, etc.).
    local version_h="/usr/include/hyprland/src/version.h"
    local commit
    if [[ -f "$version_h" ]]; then
        commit="$(grep -oP '#define GIT_COMMIT_HASH\s+"\K[0-9a-f]{40}' "$version_h" || true)"
    fi
    if [[ "$commit" =~ ^[0-9a-f]{40}$ ]]; then
        pass "hyprland version.h reports a real commit: ${commit:0:12}"
    else
        fail "hyprland version.h GIT_COMMIT_HASH is not a 40-hex hash: ${commit:-<empty>} (from ${version_h})"
    fi
}


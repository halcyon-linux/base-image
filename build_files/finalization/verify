# Audit rules and daemon configuration. Rules cannot be loaded at build time
# (no CAP_AUDIT_CONTROL), so this checks the files augenrules reads at boot.
verify_audit_config() {
    local rules_dir=/etc/audit/rules.d f mode count last

    # Fedora's stock rules.d/audit.rules is `-D` + `-a task,never`: it turns
    # syscall auditing off, and it sorts after every numbered file.
    if [[ -e "$rules_dir/audit.rules" ]]; then
        fail "stock $rules_dir/audit.rules present: its task,never rule disables syscall auditing"
    else
        pass "stock audit.rules removed"
    fi
    if grep -rEq '^[[:space:]]*-a[[:space:]]+(task,never|never,task)' "$rules_dir" 2>/dev/null; then
        fail "an audit rule disables syscall auditing (task,never) in $rules_dir"
    else
        pass "no rule disables syscall auditing"
    fi

    # A dir= rule on a symlink matches nothing, and /home and /root are symlinks
    # on bootc. The directory itself may not exist yet at build time (finalize
    # wipes /var; tmpfiles recreates it before audit-rules.service), so only
    # reject symlinks.
    local dir_path
    while IFS= read -r dir_path; do
        if [[ -L "$dir_path" ]]; then
            fail "audit rule dir= is a symlink: $dir_path"
        else
            pass "audit rule dir= is not a symlink: $dir_path"
        fi
    done < <(grep -rhoE -- '-F dir=[^ ]+' "$rules_dir" 2>/dev/null | sed 's/^-F dir=//' | sort -u)

    for f in 10-base-config 12-cont-fail 20-dont-audit 30-identity 32-power-abuse \
             40-kernel 41-persistence 44-installers 50-security-config 60-access-denied 99-finalize; do
        if [[ ! -f "$rules_dir/$f.rules" ]]; then
            fail "audit rules file missing: $rules_dir/$f.rules"
            continue
        fi
        mode=$(stat -c '%a' "$rules_dir/$f.rules")
        if [[ "$mode" == "600" ]]; then
            pass "audit rules file present, 0600: $f.rules"
        else
            fail "audit rules file mode is $mode, expected 0600: $rules_dir/$f.rules"
        fi
    done

    # auditctl(8) deprecates -w/-p watches ("poor system performance"); the
    # rules use the path=/dir= syscall form. A duplicate rule makes auditctl
    # fail with "Rule exists", and the i386 syscall table has no kexec_file_load
    # ("Unknown syscall"); with -c either turns into a failed audit-rules.service.
    if grep -rqE '^[[:space:]]*-[wW][[:space:]]' "$rules_dir" 2>/dev/null; then
        fail "deprecated -w watch rule in $rules_dir; use path=/dir= syscall rules"
    else
        pass "no deprecated -w watch rules"
    fi
    local dup_rules
    dup_rules=$(cat "$rules_dir"/*.rules 2>/dev/null | grep -E '^-' | sort | uniq -d || true)
    if [[ -n "$dup_rules" ]]; then
        fail "duplicate audit rules (auditctl rejects them): $dup_rules"
    else
        pass "no duplicate audit rules"
    fi
    if grep -rE 'arch=b32.*kexec_file_load' "$rules_dir" >/dev/null 2>&1; then
        fail "kexec_file_load in an arch=b32 rule: not in the i386 syscall table"
    else
        pass "no kexec_file_load in b32 rules"
    fi

    count=$(cat "$rules_dir"/*.rules 2>/dev/null | grep -cxF -- '-D' || true)
    if [[ "$count" == 1 ]]; then
        pass "exactly one -D (delete all) rule"
    else
        fail "expected one -D rule across $rules_dir, found $count"
    fi
    if grep -qxF -- '-b 8192' "$rules_dir/10-base-config.rules" 2>/dev/null && \
       grep -qxF -- '--loginuid-immutable' "$rules_dir/10-base-config.rules" 2>/dev/null; then
        pass "audit base config sets -b 8192 and --loginuid-immutable"
    else
        fail "10-base-config.rules must set -b 8192 and --loginuid-immutable"
    fi
    # -c exits non-zero on a bad rule so audit-rules.service fails visibly; -i
    # would exit 0 and silently drop it.
    if grep -qxF -- '-c' "$rules_dir/12-cont-fail.rules" 2>/dev/null && \
       ! grep -rqxF -- '-i' "$rules_dir" 2>/dev/null; then
        pass "audit rules continue on error with -c and never use -i"
    else
        fail "12-cont-fail.rules must contain -c and no rules file may contain -i"
    fi
    last=$(grep -hvE '^[[:space:]]*(#|$)' "$rules_dir/99-finalize.rules" 2>/dev/null | tail -n1 || true)
    if [[ "$last" == "-e 1" ]]; then
        pass "audit rules end enabled but changeable (-e 1)"
    else
        fail "99-finalize.rules must end with -e 1 (found: ${last:-nothing})"
    fi
    if [[ -e "$rules_dir/99-zz-lock.rules" ]]; then
        fail "audit lock file shipped: $rules_dir/99-zz-lock.rules (ujust audit-lock creates it)"
    else
        pass "audit lock file not shipped"
    fi

    mode=$(stat -c '%a' /etc/audit/auditd.conf 2>/dev/null || true)
    if [[ "$mode" == "640" ]]; then
        pass "auditd.conf mode is 0640"
    else
        fail "auditd.conf mode is ${mode:-missing}, expected 0640"
    fi
    if grep -qE '^log_format[[:space:]]*=[[:space:]]*ENRICHED' /etc/audit/auditd.conf 2>/dev/null; then
        pass "auditd.conf logs in ENRICHED format"
    else
        fail "auditd.conf must set log_format = ENRICHED"
    fi
    # A full or failing disk must not stop a desktop.
    if grep -qE '^[a-z_]+_action[[:space:]]*=[[:space:]]*(SINGLE|HALT|EXEC)' /etc/audit/auditd.conf 2>/dev/null; then
        fail "auditd.conf uses a SINGLE/HALT/EXEC action"
    else
        pass "auditd.conf has no SINGLE/HALT/EXEC action"
    fi

    local karg
    for karg in audit=1 audit_backlog_limit=8192; do
        if grep -v '^[[:space:]]*#' /usr/lib/bootc/kargs.d/10-halcyon-hardening.toml 2>/dev/null | grep -qF "\"$karg\""; then
            pass "audit kernel argument present: $karg"
        else
            fail "audit kernel argument missing: $karg"
        fi
    done

    # restorecond enables itself in %post; it is kept off by default.
    if [[ "$(systemctl is-enabled restorecond.service 2>/dev/null || true)" == enabled ]]; then
        fail "restorecond.service is enabled; configure-security-hardening should disable it"
    else
        pass "restorecond.service not enabled"
    fi
}

# 31-privileged.rules is generated after the last package transaction (the
# NVIDIA stage adds setuid /usr/bin/nvidia-modprobe), so check it in `final`:
# every setuid binary under /usr in the finished image must have a rule, except
# the chrome-sandbox helpers the generator skips on purpose.
verify_audit_privileged_rules() {
    local rules=/etc/audit/rules.d/31-privileged.rules bin mode
    if [[ ! -s "$rules" ]]; then
        fail "generated audit rules missing or empty: $rules"
        return 0
    fi
    mode=$(stat -c '%a' "$rules")
    if [[ "$mode" == "600" ]]; then
        pass "31-privileged.rules mode is 0600"
    else
        fail "31-privileged.rules mode is $mode, expected 0600"
    fi
    while IFS= read -r bin; do
        if grep -qF "path=$bin " "$rules"; then
            pass "privileged binary audited: $bin"
        else
            fail "setuid binary has no audit rule in 31-privileged.rules: $bin"
        fi
    done < <(find /usr -xdev -type f -perm -4000 ! -name chrome-sandbox | sort)
}

verify_security_hardening() {
    verify_audit_config

    # Banners (Lynis BANN-7126/7130): each file needs >=5 legal keyword matches.
    local banner_file keyword count
    for banner_file in /etc/issue /etc/issue.net; do
        count=0
        for keyword in warning authori prohibited subject monitor log report prosecute law; do
            if grep -qi -- "$keyword" "$banner_file" 2>/dev/null; then
                count=$((count + 1))
            fi
        done
        if ((count >= 5)); then
            pass "legal banner present in $banner_file ($count legal keywords)"
        else
            fail "legal banner missing or weak in $banner_file ($count/5 legal keywords)"
        fi
    done

    # Fail2ban (Lynis TOOL-5104): the sshd jail must exist in the effective config.
    if [[ -f /etc/fail2ban/jail.d/10-halcyon-sshd.conf ]] && \
       grep -q '^\[sshd\]' /etc/fail2ban/jail.d/10-halcyon-sshd.conf && \
       grep -qiE '^enabled[[:space:]]*=[[:space:]]*true' /etc/fail2ban/jail.d/10-halcyon-sshd.conf; then
        pass "fail2ban sshd jail enabled in jail.d"
    else
        fail "fail2ban sshd jail missing or disabled"
    fi
    if fail2ban-client -d 2>/dev/null | tr -d "[]'" | awk -F, '$1=="add" { print $2 }' | tr -d ' ' | grep -qx 'sshd'; then
        pass "fail2ban effective configuration contains the sshd jail"
    else
        fail "fail2ban effective configuration has no sshd jail"
    fi

    # Uncommon network protocols (Lynis NETW-3200) disabled via modprobe.
    local proto
    for proto in dccp sctp rds tipc; do
        if grep -qE "^install[[:space:]]+${proto}[[:space:]]+/bin/true$" /etc/modprobe.d/halcyon-hardening.conf 2>/dev/null; then
            pass "uncommon network protocol disabled: $proto"
        else
            fail "uncommon network protocol not disabled: $proto"
        fi
    done

    # Cron permissions (Lynis FILE-7524): 0600 files, 0700 directories.
    local path mode
    for path in /etc/crontab /etc/cron.deny; do
        mode=$(stat -c '%a' "$path" 2>/dev/null || true)
        if [[ "$mode" == "600" ]]; then
            pass "cron file permissions: $path is 0600"
        else
            fail "cron file permissions wrong: $path is ${mode:-missing}, expected 0600"
        fi
    done
    for path in /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly; do
        mode=$(stat -c '%a' "$path" 2>/dev/null || true)
        if [[ "$mode" == "700" ]]; then
            pass "cron directory permissions: $path is 0700"
        else
            fail "cron directory permissions wrong: $path is ${mode:-missing}, expected 0700"
        fi
    done
    if grep -q '^z /etc/crontab' /usr/lib/tmpfiles.d/halcyon-hardening.conf 2>/dev/null; then
        pass "tmpfiles rule re-enforces cron permissions at boot"
    else
        fail "tmpfiles cron permission rule missing"
    fi
    # Without this, finalize's /var wipe leaves /var/lib/fail2ban absent and the
    # server exits 255 at every boot: fail2ban_t cannot create it in var_lib_t.
    if grep -q '^d /var/lib/fail2ban' /usr/lib/tmpfiles.d/halcyon-hardening.conf 2>/dev/null; then
        pass "tmpfiles rule creates fail2ban database directory"
    else
        fail "tmpfiles rule for /var/lib/fail2ban missing"
    fi

    # Security units enabled by configure-system-services.
    local unit
    for unit in \
        /etc/systemd/system/multi-user.target.wants/fail2ban.service \
        /etc/systemd/system/multi-user.target.wants/halcyon-hosts-entry.service \
        /etc/systemd/system/multi-user.target.wants/halcyon-shadow-sync.service \
        /etc/systemd/system/multi-user.target.wants/halcyon-security-posture.service \
        /etc/systemd/system/multi-user.target.wants/halcyon-aide-init.service \
        /etc/systemd/system/timers.target.wants/halcyon-aide-check.timer \
        /etc/systemd/system/multi-user.target.wants/rngd.service \
        /etc/systemd/system/multi-user.target.wants/halcyon-mor.service; do
        if [[ -e "$unit" ]]; then
            pass "security unit enabled: $unit"
        else
            fail "security unit not enabled: $unit"
        fi
    done

    # MOR bit helper (Lynis CRYP-8006).
    if [[ -x /usr/bin/halcyon-mor ]]; then
        pass "halcyon-mor helper present and executable"
    else
        fail "/usr/bin/halcyon-mor missing or not executable"
    fi

    # faillock.conf is inert unless pam_faillock is in the PAM stack, which the
    # authselect `local` profile only does with the with-faillock feature.
    if grep -q pam_faillock /etc/pam.d/system-auth 2>/dev/null && \
       grep -q pam_faillock /etc/pam.d/password-auth 2>/dev/null; then
        pass "pam_faillock active in system-auth and password-auth"
    else
        fail "pam_faillock missing from the PAM stack; /etc/security/faillock.conf would be ignored"
    fi
    local lock_directive
    for lock_directive in 'deny = 10' 'unlock_time = 900' 'even_deny_root'; do
        if grep -qxF "$lock_directive" /etc/security/faillock.conf 2>/dev/null; then
            pass "faillock policy present: $lock_directive"
        else
            fail "faillock policy missing: $lock_directive"
        fi
    done

    # Password policy follows NIST SP 800-63B-4: long minimum, no composition rules.
    local pwq_directive
    for pwq_directive in 'minlen = 15' 'dcredit = 0' 'ucredit = 0' 'lcredit = 0' 'ocredit = 0' 'dictcheck = 1'; do
        if grep -qxF "$pwq_directive" /etc/security/pwquality.conf 2>/dev/null; then
            pass "pwquality policy present: $pwq_directive"
        else
            fail "pwquality policy missing: $pwq_directive"
        fi
    done

    # wazuh-agent lives entirely under /var/ossec, which finalize wipes.
    if [[ -e /etc/systemd/system/multi-user.target.wants/wazuh-agent.service ]]; then
        fail "wazuh-agent must not be enabled in the shipped image"
    else
        pass "wazuh-agent not enabled"
    fi

    # Group files (Lynis AUTH-9216): grpck must be silent.
    local grp_output
    grp_output=$(grpck -r 2>&1 || true)
    if [[ -z "$grp_output" ]]; then
        pass "grpck reports no group file inconsistencies"
    else
        fail "grpck reports group file inconsistencies: $grp_output"
    fi

    # secureblue-derived hardening artifacts.
    local sb_file
    for sb_file in \
        /usr/lib/sysctl.d/55-halcyon-hardening.conf \
        /usr/lib/bootc/kargs.d/10-halcyon-hardening.toml \
        /usr/lib/modprobe.d/halcyon-blocklist.conf \
        /usr/lib/modprobe.d/halcyon-framebuffer.conf \
        /etc/security/faillock.conf \
        /etc/security/pwquality.conf \
        /etc/security/limits.d/60-disable-coredump.conf \
        /etc/chrony.conf \
        /etc/firewalld/zones/FedoraWorkstation.xml \
        /usr/lib/NetworkManager/conf.d/40-halcyon.conf \
        /usr/lib/systemd/system/NetworkManager.service.d/40-halcyon-killmode.conf \
        /usr/lib/systemd/system/NetworkManager.service.d/40-halcyon-hardening.conf \
        /usr/lib/systemd/system-preset/35-halcyon-security.preset; do
        if [[ -f "$sb_file" ]]; then
            pass "hardening file present: $sb_file"
        else
            fail "hardening file missing: $sb_file"
        fi
    done

    # Spot-check the module blocklist against secureblue's attack-surface set.
    local blocked_module
    for blocked_module in rxrpc esp4 xfrm_user af_key ksmbd firewire-core nfc vivid netconsole floppy; do
        if grep -qE "^install[[:space:]]+${blocked_module}[[:space:]]+/bin/false$" /usr/lib/modprobe.d/halcyon-blocklist.conf 2>/dev/null; then
            pass "kernel module blocked: $blocked_module"
        else
            fail "kernel module not blocked: $blocked_module"
        fi
    done

    # NetworkManager sandboxing: the minimal drop-in must be present, and the
    # directives that break NetworkManager must not creep in. Directives are
    # read with comments stripped; the file documents the forbidden ones.
    local nm_dropin=/usr/lib/systemd/system/NetworkManager.service.d/40-halcyon-hardening.conf nm_directive
    for nm_directive in LockPersonality=true RestrictRealtime=true RestrictSUIDSGID=true RestrictNamespaces=true ProtectControlGroups=true SystemCallArchitectures=native \
        ProtectKernelLogs=true ProtectClock=true 'SystemCallFilter=~@clock @cpu-emulation @debug @obsolete @raw-io @reboot @swap'; do
        if grep -qxF "$nm_directive" "$nm_dropin" 2>/dev/null; then
            pass "NetworkManager hardening directive present: $nm_directive"
        else
            fail "NetworkManager hardening directive missing: $nm_directive"
        fi
    done
    if grep -v '^[[:space:]]*#' "$nm_dropin" 2>/dev/null | grep -qE '^(ProtectKernelTunables|ProtectKernelModules|ProtectSystem|ProtectHostname|ProtectProc|ProcSubset|MemoryDenyWriteExecute|NoNewPrivileges|DevicePolicy|DeviceAllow|PrivateDevices|PrivateTmp|PrivateNetwork|PrivateUsers|InaccessiblePaths|CapabilityBoundingSet)='; then
        fail "NetworkManager hardening drop-in sets a directive known to break NetworkManager"
    else
        pass "NetworkManager hardening drop-in avoids directives that break it"
    fi
    if grep -v '^[[:space:]]*#' "$nm_dropin" 2>/dev/null | grep -E '^RestrictAddressFamilies=' | grep -q 'AF_NETLINK' && \
       grep -v '^[[:space:]]*#' "$nm_dropin" | grep -E '^RestrictAddressFamilies=' | grep -q 'AF_PACKET'; then
        pass "NetworkManager keeps AF_NETLINK and AF_PACKET"
    else
        fail "NetworkManager RestrictAddressFamilies must include AF_NETLINK and AF_PACKET"
    fi

    # SELinux must stay enforcing with the targeted policy (it is what confines
    # NetworkManager_t), and no kernel argument may weaken it.
    if grep -qxF 'SELINUX=enforcing' /etc/selinux/config 2>/dev/null && \
       grep -qxF 'SELINUXTYPE=targeted' /etc/selinux/config 2>/dev/null; then
        pass "SELinux is enforcing with the targeted policy"
    else
        fail "/etc/selinux/config must set SELINUX=enforcing and SELINUXTYPE=targeted"
    fi
    if cat /usr/lib/bootc/kargs.d/*.toml 2>/dev/null | grep -v '^[[:space:]]*#' | grep -qE 'selinux=0|enforcing=0'; then
        fail "a bootc kernel argument disables SELinux"
    else
        pass "no bootc kernel argument disables SELinux"
    fi

    # Confinement of these daemons hangs on one file context each: without it the
    # binary is bin_t and systemd starts it as unconfined_service_t, silently.
    # smartd already lost its context this way (policy still says /usr/sbin/smartd,
    # which no longer matches after the /usr/sbin merge), so assert the /usr/bin
    # paths for the security-relevant services this image depends on.
    local fc=/etc/selinux/targeted/contexts/files/file_contexts exec_ctx
    for exec_ctx in NetworkManager:NetworkManager_exec_t firewalld:firewalld_exec_t aide:aide_exec_t; do
        # /usr/bin only: a /usr/sbin entry is exactly the stale form smartd has.
        if grep -qE "^/usr/bin/${exec_ctx%%:*}[[:space:]]+--[[:space:]]+system_u:object_r:${exec_ctx#*:}:" "$fc" 2>/dev/null; then
            pass "SELinux confines /usr/bin/${exec_ctx%%:*} (${exec_ctx#*:})"
        else
            fail "no /usr/bin file context for ${exec_ctx%%:*} -> ${exec_ctx#*:}: it would run unconfined"
        fi
    done

    # Modules that must stay loadable: cifs.ko depends on cifs_md4, the Intel
    # ice NIC driver and the WWAN stack depend on the gnss core, and UDF is the
    # filesystem of DVD/Blu-ray data discs.
    for blocked_module in cifs_md4 gnss udf; do
        if grep -qE "^[[:space:]]*(install|blacklist)[[:space:]]+${blocked_module}([[:space:]]|$)" /usr/lib/modprobe.d/halcyon-blocklist.conf 2>/dev/null; then
            fail "kernel module must not be blocked: $blocked_module"
        else
            pass "kernel module stays loadable: $blocked_module"
        fi
    done

    # sysctl guards: values that were deliberately relaxed from secureblue.
    local sysctl_conf=/usr/lib/sysctl.d/55-halcyon-hardening.conf
    if grep -qxF 'net.ipv4.conf.all.rp_filter = 2' "$sysctl_conf" 2>/dev/null && \
       grep -qxF 'net.ipv4.conf.default.rp_filter = 2' "$sysctl_conf" 2>/dev/null; then
        pass "rp_filter is loose (2) for tunnel and bridge interfaces"
    else
        fail "rp_filter must stay loose (2): strict mode breaks Tailscale/container routing"
    fi
    if grep -qE '^[[:space:]]*(fs\.binfmt_misc\.status|net\.ipv4\.tcp_timestamps)[[:space:]]*=' "$sysctl_conf" 2>/dev/null; then
        fail "sysctl hardening must not set fs.binfmt_misc.status or net.ipv4.tcp_timestamps"
    else
        pass "binfmt_misc and tcp_timestamps left at kernel defaults"
    fi

    if grep -q 'hash_pointers=always' /usr/lib/bootc/kargs.d/10-halcyon-hardening.toml 2>/dev/null && \
       grep -q 'page_alloc.shuffle=1' /usr/lib/bootc/kargs.d/10-halcyon-hardening.toml 2>/dev/null && \
       ! grep -v '^[[:space:]]*#' /usr/lib/bootc/kargs.d/10-halcyon-hardening.toml | grep -qE 'rd\.shell=0|rd\.emergency=halt|loglevel=0'; then
        pass "bootc hardening kernel arguments present"
    else
        fail "bootc hardening kernel arguments missing"
    fi

    # SELinux policy modules (secureblue socket-class restrictions, plus the
    # nix-daemon socket label), installed at runtime by halcyon-security-posture.
    # A module that is shipped but absent from the script's policies array would
    # never be installed, so assert both.
    local cil_policy
    for cil_policy in secureblue_socket_utils secureblue_audit_sockets secureblue_deny_alg_sockets secureblue_deny_ipsec_sockets secureblue_deny_obscure_sockets secureblue_deny_packet_radio_sockets halcyon_nix_daemon_socket; do
        if [[ -f "/usr/share/halcyon/selinux/${cil_policy}.cil" ]]; then
            pass "SELinux policy shipped: ${cil_policy}"
        else
            fail "SELinux policy missing: ${cil_policy}"
        fi
        if grep -qE "^policies=\\(.*\\b${cil_policy}\\b" /usr/bin/halcyon-security-posture; then
            pass "SELinux policy installed at boot: ${cil_policy}"
        else
            fail "SELinux policy not referenced by halcyon-security-posture: ${cil_policy}"
        fi
    done

    # /nix is a bind mount of /var/nix, so every file context has to be stated
    # for both paths: a restorecon reaching an inode through the source path
    # would otherwise take var_t from the base /var(/.*)? rule. A /nix rule
    # added without its mirror is the easy mistake, so compare the two sets.
    local nix_cil=/usr/share/halcyon/selinux/halcyon_nix_daemon_socket.cil
    local nix_fc var_fc
    nix_fc=$(grep -oE '\(filecon "/nix/[^"]+"' "$nix_cil" 2>/dev/null | sed -E 's/.*"(.*)"/\1/' | sort)
    var_fc=$(grep -oE '\(filecon "/var/nix/[^"]+"' "$nix_cil" 2>/dev/null | sed -E 's/.*"(.*)"/\1/; s|^/var||' | sort)
    if [[ -z "$nix_fc" ]]; then
        fail "no /nix file contexts found in ${nix_cil}"
    elif [[ "$nix_fc" == "$var_fc" ]]; then
        pass "nix SELinux file contexts mirrored under /var/nix"
    else
        fail "nix SELinux file contexts not mirrored under /var/nix: $(diff <(printf '%s\n' "$nix_fc") <(printf '%s\n' "$var_fc") | tr '\n' ' ')"
    fi

    # The module only states the label; this tmpfiles rule is what applies it,
    # and it runs before sysinit.target, so nix-daemon.socket sees the label in
    # the same boot. halcyon-security-posture is ordered after basic.target and
    # could only ever have fixed the next boot.
    if grep -qE '^z /nix/var/nix/daemon-socket' /usr/lib/tmpfiles.d/nix.conf 2>/dev/null; then
        pass "tmpfiles rule relabels the nix daemon-socket directory"
    else
        fail "tmpfiles relabel rule for /nix/var/nix/daemon-socket missing"
    fi

    # Service posture: passim must be masked, sssd must not be enabled.
    if [[ "$(readlink -f /etc/systemd/system/passim.service 2>/dev/null)" == "/dev/null" ]]; then
        pass "passim.service masked"
    else
        fail "passim.service is not masked"
    fi
    if [[ ! -e /etc/systemd/system/multi-user.target.wants/sssd.service ]]; then
        pass "sssd.service disabled"
    else
        fail "sssd.service is still enabled"
    fi

    # ujust onboarding recipes.
    if [[ -f /usr/share/ublue-os/just/90-security.just ]] && \
       grep -q '^aide-check' /usr/share/ublue-os/just/90-security.just && \
       grep -q '^aide-rebaseline' /usr/share/ublue-os/just/90-security.just; then
        pass "security ujust recipes present (aide actions)"
    else
        fail "security ujust recipes missing or incomplete"
    fi
}

verify_final() {
    local info kver

    # The GRUB menu must still be visible in the published image.
    verify_grub

    # Later stages (Terra, Fedora) must not have replaced a cli-tools COPR build,
    # and the generated audit rules must cover the finished image.
    verify_cli_tools_source
    verify_audit_privileged_rules

    require_repos_disabled \
        'copr:copr.fedorainfracloud.org:aahsnr-work:cli-tools' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:python-packages' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:gaming' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:fonts' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:base-pkgs' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:applications' \
        'copr:copr.fedorainfracloud.org:aahsnr-work:texlive-packages' \
        'code' \
        'gitlab.com_paulcarroty_vscodium_repo' \
        'brave-browser' \
        'google-chrome' \
        'microsoft-edge' \
        'vivaldi' \
        'gh-cli' \
        'copr:copr.fedorainfracloud.org:ublue-os:bazzite-multilib:ml' \
        fedora-multimedia

    # Negative guards: fonts and waydroid must never reach the published image.
    # wazuh-agent installs entirely under /var/ossec, which finalize wipes.
    forbid_rpms \
        wazuh-agent \
        nerd-fonts fira-code-fonts lato-fonts google-noto-sans-cjk-fonts twitter-twemoji-fonts \
        google-roboto-fonts google-roboto-mono-fonts \
        waydroid waydroid-nvidia obs-studio-plugin-vkcapture-hook-libs \
        jupiter-fan-control jupiter-hw-support-btrfs jupiter-sd-mounting-btrfs \
        steamdeck-dsp steamdeck-backgrounds steamdeck-gnome-presets steamdeck-kde-presets \
        inputplumber steamos-manager-powerstation steamos-manager \
        gamescope-session-ogui-steam powerbuttond vpower sdgyrodsu galileo-mura \
        pinentry-qt

    # Cockpit and the VM host stack were removed on purpose (no web admin
    # console, no VM host stack, no GPU-passthrough tooling). virtiofsd is the
    # exception: VM and podman machine file sharing needs it, so it must stay
    # installed while the rest of the stack is forbidden.
    forbid_rpms \
        cockpit-bridge cockpit-ws cockpit-files cockpit-networkmanager cockpit-podman \
        cockpit-selinux cockpit-storaged cockpit-system \
        libvirt-daemon libvirt-daemon-kvm libvirt-daemon-config-network \
        libvirt-daemon-config-nwfilter virt-manager virt-install \
        edk2-ovmf ls-iommu qemu-kvm

    require_rpms virtiofsd

    # Device-specific trim: kernel modules for absent hardware must not reappear.
    forbid_rpms \
        kmod-zenergy kmod-ryzen_smu kmod-wl kmod-openrazer kmod-xone kmod-gcadapter_oc \
        kmod-evdi kmod-kvmfr kmod-new-lg4ff kmod-hid-tmff2 kmod-t150-driver \
        kmod-hid-fanatecff kmod-sc0710 kmod-system76-driver kmod-system76-io kmod-v4l2loopback

    # The offline docs bundle was removed on purpose (it was the only carrier
    # of the Roboto/Roboto Mono webfonts).
    if [[ -e /usr/share/ublue-os/docs ]]; then
        fail "offline docs bundle present: /usr/share/ublue-os/docs"
    else
        pass "offline docs bundle absent"
    fi

    # Ensure Steam does not autostart on user login.
    local autostart_path
    for autostart_path in \
        /etc/skel/.config/autostart/steam.desktop \
        /etc/xdg/autostart/steam.desktop \
        /usr/share/autostart/steam.desktop; do
        if [[ -e "$autostart_path" ]]; then
            fail "Steam autostart entry present: $autostart_path"
        else
            pass "Steam autostart entry absent: $autostart_path"
        fi
    done

    # zsh must be the default login shell.
    if grep -qxF '/usr/bin/zsh' /etc/shells 2>/dev/null; then
        pass "zsh present in /etc/shells"
    else
        fail "zsh missing from /etc/shells"
    fi
    if grep -qP '^root:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:/usr/bin/zsh$' /etc/passwd 2>/dev/null; then
        pass "root shell is /usr/bin/zsh"
    else
        fail "root shell is not /usr/bin/zsh"
    fi
    if [[ -f /etc/skel/.zshrc ]]; then
        pass "/etc/skel/.zshrc is present"
    else
        fail "/etc/skel/.zshrc is missing"
    fi
    if [[ -x /usr/bin/pinentry-wrapper ]]; then
        pass "pinentry-wrapper present and executable: /usr/bin/pinentry-wrapper"
    else
        fail "pinentry-wrapper missing or not executable: /usr/bin/pinentry-wrapper"
    fi
    if [[ -f /etc/skel/.gnupg/gpg-agent.conf ]]; then
        pass "gpg-agent.conf present: /etc/skel/.gnupg/gpg-agent.conf"
    else
        fail "gpg-agent.conf missing: /etc/skel/.gnupg/gpg-agent.conf"
    fi
    if [[ -f /usr/share/zsh/site-functions/zsh-preexec.zsh ]]; then
        pass "zsh-preexec shim present: /usr/share/zsh/site-functions/zsh-preexec.zsh"
    else
        fail "zsh-preexec shim missing: /usr/share/zsh/site-functions/zsh-preexec.zsh"
    fi
    # /etc/skel/.zshrc must not reference auxiliary zsh packages that are not installed.
    if grep -qE 'zsh-autosuggestions|zsh-syntax-highlighting' /etc/skel/.zshrc 2>/dev/null; then
        fail "/etc/skel/.zshrc references forbidden auxiliary zsh packages"
    else
        pass "/etc/skel/.zshrc contains no auxiliary zsh package references"
    fi

    # SDDM must be the display manager; greetd must be absent.
    if [[ -e /usr/lib/systemd/system/sddm.service ]]; then
        pass "sddm.service unit present"
    else
        fail "sddm.service unit missing"
    fi
    if [[ -e /etc/systemd/system/display-manager.service ]] || \
       [[ -e /etc/systemd/system/graphical.target.wants/sddm.service ]]; then
        pass "sddm.service is enabled as display manager"
    else
        fail "sddm.service is not enabled as display manager"
    fi
    for greetd_path in /usr/bin/greetd /etc/greetd /usr/lib/systemd/system/greetd.service; do
        if [[ -e "$greetd_path" ]]; then
            fail "greetd artifact present (must be absent): $greetd_path"
        else
            pass "greetd artifact absent: $greetd_path"
        fi
    done

    info=/usr/share/ublue-os/image-info.json
    if [[ -f "$info" ]] && jq -e '(."image-name" | strings | length > 0) and (."image-branch" | strings | length > 0) and (."image-ref" | strings | length > 0)' "$info" >/dev/null; then
        pass "image-info.json populated: $info"
    else
        fail "image-info.json missing or incomplete: $info"
    fi
    if jq -e '."image-ref" | startswith("ostree-image-signed:docker://ghcr.io/")' "$info" >/dev/null 2>&1; then
        pass "image-ref uses the signed ghcr.io scheme"
    else
        fail "image-ref must start with ostree-image-signed:docker://ghcr.io/: $(jq -r '."image-ref"' "$info" 2>/dev/null || echo missing)"
    fi

    kver="$(dnf5 repoquery --installed --queryformat='%{evr}.%{arch}' kernel 2>/dev/null | head -n1 || true)"
    if [[ -z "$kver" ]]; then
        kver="$(rpm -q kernel-core --qf '%{evr}.%{arch}\n' 2>/dev/null | head -n1 || true)"
    fi
    if [[ -n "$kver" && -d "/usr/lib/modules/$kver" ]]; then
        pass "installed kernel has matching modules dir: /usr/lib/modules/$kver"
    else
        fail "kernel modules dir mismatch: kernel=${kver:-none}"
    fi

    local -a modprobe_dirs
    mapfile -t modprobe_dirs < <(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
    if [[ ${#modprobe_dirs[@]} -eq 1 ]]; then
        pass "single kernel tree retained in final image: ${modprobe_dirs[0]}"
    else
        fail "expected single kernel tree, found ${#modprobe_dirs[@]}: ${modprobe_dirs[*]:-none}"
    fi

    local kernel_flavor
    kernel_flavor="$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}' 2>/dev/null || true)"
    if [[ "$kernel_flavor" == *fsync* || "$kernel_flavor" == *ogc* ]]; then
        pass "gaming kernel retained: $kernel_flavor"
    else
        fail "gaming kernel missing from final image (found: ${kernel_flavor:-none})"
    fi

    if [[ -n "$(find /usr/lib/modules -name 'nct6687*.ko*' -print -quit 2>/dev/null)" ]]; then
        pass "extra kmod present: nct6687d"
    else
        fail "required extra kmod missing: nct6687d"
    fi

    # The graphics stack must survive the whole build: Mesa (Fedora's is
    # excluded) must still be one build, x86_64 and i686, next to the NVIDIA
    # driver in the published image.
    verify_mesa_stack

    if [[ -n "$(find /usr/lib/modules -name 'nvidia.ko*' -print -quit 2>/dev/null)" ]]; then
        pass "nvidia kmod present"
    else
        fail "nvidia kmod missing from final image"
    fi

    local required_binary
    for required_binary in \
        /usr/bin/ujust /usr/bin/ujust-picker /usr/bin/bbrew-helper /usr/bin/bruh \
        /usr/bin/hardware-setup /usr/bin/user-setup /usr/bin/dynamic-fixes \
        /usr/bin/ublue-motd /usr/bin/uupd-update /usr/bin/dlss-swapper \
        /usr/bin/steam /usr/bin/lutris /usr/bin/protonplus /usr/bin/winetricks \
        /usr/bin/bazaar /usr/bin/uupd /usr/bin/fastfetch /usr/bin/btop \
        /usr/bin/input-remapper-control /usr/bin/snapper /usr/bin/btrfs-assistant \
        /usr/bin/chezmoi /usr/bin/flatpak /usr/bin/sddm \
        /usr/bin/code /usr/bin/codium /usr/bin/brave-browser /usr/bin/firefox \
        /usr/bin/google-chrome /usr/bin/microsoft-edge /usr/bin/vivaldi \
        /usr/bin/nvim /usr/bin/kitty \
        /usr/bin/Hyprland /usr/bin/hyprpm \
        /usr/bin/pinentry-wrapper \
        /usr/bin/g++ /usr/bin/meson /usr/bin/cpio; do
        if [[ -x "$required_binary" ]]; then
            pass "command present and executable: $required_binary"
        else
            fail "command missing or not executable: $required_binary"
        fi
    done

    if [[ -d /usr/share/icons/Papirus ]]; then
        pass "Papirus icon theme installed"
    else
        fail "Papirus icon theme missing"
    fi

    local unit
    for unit in \
        /usr/lib/systemd/system/hardware-setup.service \
        /usr/lib/systemd/system/greenboot-healthcheck.service \
        /usr/lib/systemd/system/greenboot-set-rollback-trigger.service \
        /usr/lib/systemd/system/dmemcg-booster-system.service \
        /usr/lib/systemd/system/uupd.timer \
        /usr/lib/systemd/system/sddm.service \
        /usr/lib/systemd/system/var-nix.service \
        /usr/lib/systemd/system/nix.mount \
        /usr/lib/systemd/system/nix-daemon.service \
        /usr/lib/systemd/system/nix-daemon.socket \
        /usr/lib/tmpfiles.d/nix.conf \
        /etc/profile.d/00-nix-resolve-home-env.sh \
        /etc/nix/nix.conf \
        /usr/lib/systemd/user/user-setup.service \
        /usr/lib/systemd/user/dynamic-fixes.service \
        /usr/lib/systemd/user/dmemcg-booster-user.service \
        /usr/lib/systemd/user/chezmoi-init.service \
        /usr/lib/systemd/user/chezmoi-update.timer; do
        if [[ -e "$unit" ]]; then
            pass "unit file present: $unit"
        else
            fail "unit file missing: $unit"
        fi
    done

    for unit in \
        /usr/lib/systemd/system/bazzite-hardware-setup.service \
        /usr/lib/systemd/system/bazzite-iwd-migration.service \
        /usr/lib/systemd/system/bazzite-libvirtd-setup.service \
        /usr/lib/systemd/system/cockpit.service \
        /usr/share/containers/systemd/cockpit-container.container \
        /usr/lib/tmpfiles.d/bazzite-libvirt.conf \
        /usr/lib/dracut/dracut.conf.d/80-vfio.conf \
        /usr/lib/systemd/system/force-wol.service \
        /usr/lib/systemd/system/incus-workaround.service \
        /usr/lib/systemd/system/greetd.service \
        /usr/lib/systemd/user/ntfs-nag.service; do
        if [[ -e "$unit" ]]; then
            fail "obsolete/removed unit file present: $unit"
        else
            pass "obsolete/removed unit file absent: $unit"
        fi
    done

    if [[ -e /usr/lib/systemd/system/service.d/50-keep-warm.conf ]]; then
        fail "keep-warm systemd drop-in present: /usr/lib/systemd/system/service.d/50-keep-warm.conf"
    else
        pass "keep-warm systemd drop-in absent"
    fi

    if [[ -d /usr/share/ublue-os/bazaar ]]; then
        pass "bazaar software directory present: /usr/share/ublue-os/bazaar"
    else
        fail "bazaar software directory missing: /usr/share/ublue-os/bazaar"
    fi

    if [[ -L /etc/bazaar/bazaar.yaml && "$(readlink /etc/bazaar/bazaar.yaml)" == "/usr/share/ublue-os/bazaar/main.yaml" && \
          -L /etc/bazaar/config.yaml && "$(readlink /etc/bazaar/config.yaml)" == "/usr/share/ublue-os/bazaar/content.yaml" ]]; then
        pass "bazaar configuration symlinks present in /etc/bazaar"
    else
        fail "bazaar configuration symlinks missing or misdirected in /etc/bazaar"
    fi

    if grep -q '<allow_any>yes</allow_any>' \
        /usr/share/polkit-1/actions/org.bazzite.privileged.user.setup.policy 2>/dev/null; then
        fail "polkit action insecurely defaults allow_any to yes"
    else
        pass "polkit action has secure defaults"
    fi

    # chezmoi user units and global enablement
    local chezmoi_unit
    for chezmoi_unit in \
        /usr/lib/systemd/user/chezmoi-init.service \
        /usr/lib/systemd/user/chezmoi-update.service \
        /usr/lib/systemd/user/chezmoi-update.timer; do
        if [[ -e "$chezmoi_unit" ]]; then
            pass "chezmoi unit present: $chezmoi_unit"
        else
            fail "chezmoi unit missing: $chezmoi_unit"
        fi
    done

    for chezmoi_unit in \
        /etc/systemd/user/default.target.wants/chezmoi-init.service \
        /etc/systemd/user/timers.target.wants/chezmoi-update.timer; do
        if [[ -e "$chezmoi_unit" ]]; then
            pass "chezmoi unit enabled: $chezmoi_unit"
        else
            fail "chezmoi unit not enabled: $chezmoi_unit"
        fi
    done

    if grep -qF 'aahsnr-configs/dotfiles' /usr/lib/systemd/user/chezmoi-init.service 2>/dev/null && \
       grep -qF -- '--force' /usr/lib/systemd/user/chezmoi-init.service 2>/dev/null && \
       grep -qF 'pushInsteadOf' /usr/lib/systemd/user/chezmoi-init.service 2>/dev/null && \
       grep -qF 'core.sshCommand' /usr/lib/systemd/user/chezmoi-init.service 2>/dev/null; then
        pass "chezmoi-init clones aahsnr-configs/dotfiles anonymously (HTTPS) and pins SSH pushes"
    else
        fail "chezmoi-init does not pin the HTTPS-pull / SSH-push policy for aahsnr-configs/dotfiles"
    fi

    if [[ -f /etc/ssh/ssh_config.d/10-halcyon-github.conf ]] && \
       grep -qF 'Host github.com' /etc/ssh/ssh_config.d/10-halcyon-github.conf 2>/dev/null && \
       grep -qF 'id_ed25519_aahsnr_configs' /etc/ssh/ssh_config.d/10-halcyon-github.conf 2>/dev/null; then
        pass "system-wide default github.com SSH identity present"
    else
        fail "system-wide default github.com SSH identity missing or wrong key"
    fi

    # Lynis PKGS-7303 runs `brew list` as root, which Homebrew refuses. The skip
    # lives in /etc/lynis/custom.prf, where Lynis reads it.
    if grep -qxF 'skip-test=PKGS-7303' /etc/lynis/custom.prf 2>/dev/null; then
        pass "Lynis skips PKGS-7303 (brew refuses root)"
    else
        fail "/etc/lynis/custom.prf must skip PKGS-7303"
    fi

    # CRYP-8005 only looks for a haveged-style process; haveged is not shipped.
    if grep -qxF 'skip-test=CRYP-8005' /etc/lynis/custom.prf 2>/dev/null; then
        pass "Lynis skips CRYP-8005 (haveged not shipped)"
    else
        fail "/etc/lynis/custom.prf must skip CRYP-8005"
    fi
    forbid_rpms haveged

    # PKGS-7420 only detects dnf-automatic and friends; uupd updates this image.
    if grep -qxF 'skip-test=PKGS-7420' /etc/lynis/custom.prf 2>/dev/null; then
        pass "Lynis skips PKGS-7420 (uupd, not dnf-automatic)"
    else
        fail "/etc/lynis/custom.prf must skip PKGS-7420"
    fi

    # NAME-4028: the hosts entry must carry a domain so dnsdomainname answers.
    if grep -qF '.localdomain' /usr/bin/halcyon-hosts-entry 2>/dev/null; then
        pass "halcyon-hosts-entry writes a domain-qualified entry"
    else
        fail "halcyon-hosts-entry must write <host>.localdomain (Lynis NAME-4028)"
    fi

    # sshd hardening drop-in (Lynis SSH-7408). The 10- prefix matters: sshd
    # keeps the first value seen per keyword, so it must sort before Fedora's
    # 50-redhat.conf. Exact-line matches so a weakened value (e.g. MaxAuthTries 30) fails.
    local sshd_directive sshd_conf=/etc/ssh/sshd_config.d/10-halcyon-hardening.conf
    if [[ -f "$sshd_conf" ]]; then
        pass "sshd hardening drop-in present: $sshd_conf"
        for sshd_directive in \
            'Port 43210' \
            'PermitRootLogin no' \
            'PasswordAuthentication no' \
            'KbdInteractiveAuthentication no' \
            'PermitEmptyPasswords no' \
            'AllowGroups wheel' \
            'MaxAuthTries 3' \
            'LoginGraceTime 30' \
            'MaxSessions 2' \
            'MaxStartups 10:30:60' \
            'Banner /etc/issue.net' \
            'AllowAgentForwarding no' \
            'AllowTcpForwarding no' \
            'X11Forwarding no' \
            'TCPKeepAlive no' \
            'ClientAliveInterval 300' \
            'ClientAliveCountMax 2' \
            'LogLevel VERBOSE'; do
            if grep -qxF "$sshd_directive" "$sshd_conf" 2>/dev/null; then
                pass "sshd hardening directive present: $sshd_directive"
            else
                fail "sshd hardening directive missing: $sshd_directive"
            fi
        done
    else
        fail "sshd hardening drop-in missing: $sshd_conf"
    fi

    # AUTH-9216 insurance at the last gate: account relocation and any NVIDIA
    # transaction scriptlets run after the security-hardening stage.
    local grp_final
    grp_final=$(grpck -r 2>&1 || true)
    if [[ -z "$grp_final" ]]; then
        pass "grpck reports no group file inconsistencies (final)"
    else
        fail "grpck reports group file inconsistencies (final): $grp_final"
    fi

    if grep -qF -- '--no-tty --force' /usr/lib/systemd/user/chezmoi-update.service 2>/dev/null; then
        pass "chezmoi-update targets non-interactive update with --force"
    else
        fail "chezmoi-update missing --no-tty --force"
    fi

    # Flatpak policy: no applications provisioned, system Flathub remote only,
    # Bazaar (dnf) is the software center.
    if [[ -f /etc/flatpak/remotes.d/flathub.flatpakrepo ]] && grep -qF 'https://dl.flathub.org/repo/' /etc/flatpak/remotes.d/flathub.flatpakrepo 2>/dev/null; then
        pass "flathub.flatpakrepo remote definition present"
    else
        fail "flathub.flatpakrepo missing or invalid"
    fi

    local extraflatremote
    extraflatremote=$(find /etc/flatpak/remotes.d -maxdepth 1 -type f ! -name flathub.flatpakrepo 2>/dev/null || true)
    if [[ -n "$extraflatremote" ]]; then
        fail "unexpected remote definitions in /etc/flatpak/remotes.d (only flathub is allowed): $extraflatremote"
    else
        pass "/etc/flatpak/remotes.d declares only flathub"
    fi

    if [[ -d /usr/share/flatpak/remotes.d ]]; then
        extraflatremote=$(find /usr/share/flatpak/remotes.d -maxdepth 1 -type f ! -name flathub.flatpakrepo 2>/dev/null || true)
        if [[ -n "$extraflatremote" ]]; then
            fail "unexpected remote definitions in /usr/share/flatpak/remotes.d (only flathub is allowed): $extraflatremote"
        else
            pass "/usr/share/flatpak/remotes.d declares only flathub"
        fi
    fi

    local flatpak_artifact
    for flatpak_artifact in \
        /usr/share/ublue-os/flatpak/system-flatpaks.list \
        /usr/libexec/system-flatpak-setup \
        /usr/lib/systemd/system/system-flatpak-setup.service \
        /etc/systemd/system/multi-user.target.wants/system-flatpak-setup.service; do
        if [[ -e "$flatpak_artifact" ]]; then
            fail "removed flatpak provisioning artifact present: $flatpak_artifact"
        else
            pass "flatpak provisioning artifact absent: $flatpak_artifact"
        fi
    done

    local system_flatpaks
    if system_flatpaks=$(flatpak list --system --app --columns=application 2>/dev/null || true) && [[ -n "$system_flatpaks" ]]; then
        fail "system flatpak applications installed by default: $system_flatpaks"
    else
        pass "no system flatpak applications installed"
    fi

    require_rpms bazaar flatpak

    # /opt directory layout: must be an immutable directory in root, not a symlink to /var/opt
    if [[ -d /opt && ! -L /opt ]]; then
        pass "/opt is a real directory in final image"
    else
        fail "/opt is missing or a symlink in final image"
    fi
}

case "$group" in
brew) verify_brew ;;
kernel) verify_kernel ;;
repos) verify_repos ;;
cli-tools) verify_cli_tools ;;
utils) verify_utils ;;
removals) verify_removals ;;
common-packages) verify_common_packages ;;
gaming) verify_gaming ;;
fonts) verify_fonts ;;
base-pkgs) verify_base_pkgs ;;
hyprpm) verify_hyprpm ;;
applications) verify_applications ;;
texlive-packages) verify_texlive_packages ;;
nix) verify_nix ;;
picker) verify_picker ;;
media) verify_media ;;
desktop-integration) verify_desktop_integration ;;
justfiles) verify_justfiles ;;
services) verify_services ;;
grub) verify_grub ;;
integration-files) verify_integration_files ;;
image-info) verify_image_info ;;
initramfs) verify_initramfs ;;
finalize) verify_finalize ;;
nvidia-config) verify_nvidia_config ;;
nvidia) verify_nvidia ;;
system-policy) verify_system_policy ;;
nvidia-finalize) verify_nvidia_finalize ;;
security) verify_security ;;
security-hardening) verify_security_hardening ;;
packages) verify_packages ;;
final) verify_final ;;
esac

if ((${#failures[@]})); then
    printf '\nverify (%s): %d check(s) failed\n' "$group" "${#failures[@]}" >&2
    exit 1
fi

printf '\nverify (%s): all checks passed\n' "$group"

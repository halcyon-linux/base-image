#!/usr/bin/env bash

set -Eeuo pipefail

# Files below are pinned and sha256-checked by the downloads stage
# (build_files/downloads/manifest.tsv).

# Reference DXVK configuration.
install -D -m 0644 /downloads/dxvk.conf /etc/dxvk-example.conf

# Distrobox Docker template configuration.
install -D -m 0644 /downloads/distrobox-docker.ini /etc/distrobox/docker.ini
setfattr -n user.component -v 'toolbox-config' /etc/distrobox/docker.ini 2>/dev/null || true

# bash-preexec shell hook.
install -D -m 0644 /downloads/bash-preexec.sh /usr/share/bash-prexec
setfattr -n user.component -v 'bash-preexec' /usr/share/bash-prexec 2>/dev/null || true
ln -sfn /usr/share/bash-prexec /usr/share/bash-preexec

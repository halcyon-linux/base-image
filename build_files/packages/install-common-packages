#!/usr/bin/env bash

set -Eeuo pipefail

# Read package list from packages.json
PACKAGES_JSON="/ctx/packages.json"
if [[ ! -f "$PACKAGES_JSON" ]]; then
    echo "ERROR: packages.json not found at $PACKAGES_JSON" >&2
    exit 1
fi

# Extract common-packages list from JSON
mapfile -t common_packages < <(jq -r '."common-packages".packages[]' "$PACKAGES_JSON")

# Extra installs from COPR (scx-scheds, scx-tools)
mapfile -t extra_installs < <(jq -r '."common-packages".extra_installs[]' "$PACKAGES_JSON" 2>/dev/null || true)
if ((${#extra_installs[@]})); then
    dnf5 -y copr enable bieszczaders/kernel-cachyos-addons
    dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y install "${extra_installs[@]}"
    dnf5 -y copr disable bieszczaders/kernel-cachyos-addons
fi

# Install main package list
dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y install "${common_packages[@]}"

# Additional packages from specific repos
mapfile -t additional_packages < <(jq -r '."common-packages".additional[]' "$PACKAGES_JSON" 2>/dev/null || true)
for entry in "${additional_packages[@]}"; do
    # Format: "package-name (from repo-name)"
    pkg=$(awk '{print $1}' <<<"$entry")
    repo=$(sed -n 's/.*(from \([^)]*\)).*/\1/p' <<<"$entry")
    if [[ -n "$repo" ]]; then
        dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y install --enable-repo="$repo" "$pkg"
    else
        dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y install "$pkg"
    fi
done

# Package swaps
mapfile -t swaps < <(jq -r '."common-packages".swaps[]' "$PACKAGES_JSON" 2>/dev/null || true)
for entry in "${swaps[@]}"; do
    # Format: "old-package -> new-package (from repo-name)"
    old_pkg=$(awk '{print $1}' <<<"$entry")
    new_pkg=$(awk '{print $3}' <<<"$entry")
    repo=$(sed -n 's/.*(from \([^)]*\)).*/\1/p' <<<"$entry")
    if [[ -n "$repo" ]]; then
        dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y swap --allowerasing --repo="$repo" "$old_pkg" "$new_pkg"
    else
        dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y swap --allowerasing "$old_pkg" "$new_pkg"
    fi
done

mkdir -p /etc/NetworkManager/dispatcher.d
ln -sfn /dev/null /etc/NetworkManager/dispatcher.d/04-iscsi
systemctl mask iscsi
systemctl mask systemd-remount-fs.service
systemctl mask fedora-atomic-desktop-appstream-cache-refresh

install -D -m 0644 /downloads/libextest.so /usr/lib/extest/libextest.so

setfattr -n user.component -v extest /usr/lib/extest/libextest.so 2>/dev/null || true
install -d /etc/xdg/autostart

# Disabled with Waydroid:
# sed -i~ -E 's/=\$\(command -v (nft|ip6?tables-legacy).*/=/g' /usr/lib/waydroid/data/scripts/waydroid-net.sh
if [[ -f /usr/bin/btrfs-assistant-launcher ]]; then
    sed -i 's/ --xdg-runtime=\\"${XDG_RUNTIME_DIR}\\"//g' \
        /usr/bin/btrfs-assistant-launcher
fi

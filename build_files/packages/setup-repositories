#!/usr/bin/env bash

set -Eeuo pipefail

mkdir -p /var/roothome
dnf5 config-manager setopt keepcache=1
# Install no docs, man or info pages for build-time packages (image size).
# finalize unsets it so the shipped dnf.conf keeps the stock default.
dnf5 config-manager setopt tsflags=nodocs

# Ensure /opt is a real directory in the immutable root filesystem, not a symlink to /var/opt.
# Fedora Atomic base images ship /opt -> var/opt; replacing it with a directory avoids
# cpio unpack errors ('File exists' / 'No such file or directory') when installing RPMs
# that deliver files into /opt, and ensures application payloads are retained by bootc.
if [[ -L /opt ]]; then
    rm -f /opt
    mkdir -p /opt
    chmod 0755 /opt
fi

copr_repositories=(
    ublue-os/bazzite
    ublue-os/bazzite-multilib
    ublue-os/staging
    ublue-os/packages
)
# The Halcyon package COPRs are enabled only by their corresponding install
# scripts, where each repo's priority and lifecycle are kept together.

for copr in "${copr_repositories[@]}"; do
    printf 'Enabling Copr repository: %s\n' "$copr"
    dnf5 -y copr enable "$copr"
    repo_id="copr:copr.fedorainfracloud.org:${copr////:}"
    dnf5 -y config-manager setopt "${repo_id}.priority=98"
done

dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y install --nogpgcheck \
    --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' \
    terra-release terra-release-extras terra-release-mesa

dnf5 -y config-manager addrepo \
    --overwrite \
    --from-repofile=https://pkgs.tailscale.com/stable/fedora/tailscale.repo

dnf5 -y config-manager addrepo \
    --overwrite \
    --from-repofile=https://cli.github.com/packages/rpm/gh-cli.repo

if [[ -f /etc/yum.repos.d/negativo17-fedora-multimedia.repo ]]; then
    sed -i 's@enabled=0@enabled=1@g' \
        /etc/yum.repos.d/negativo17-fedora-multimedia.repo
fi

dnf5 -y config-manager setopt \
    '*terra*'.priority=1 \
    '*terra*'.exclude='nerd-fonts scx-tools scx-scheds python3-protobuf zlib-devel uupd'
dnf5 -y config-manager setopt 'terra-mesa'.enabled=false
dnf5 -y config-manager setopt '*bazzite*'.priority=2

if [[ -f /etc/yum.repos.d/negativo17-fedora-multimedia.repo ]]; then
    dnf5 -y config-manager setopt \
        '*fedora-multimedia*'.priority=4 \
        '*fedora-multimedia*'.exclude='mesa-* *xone*'
fi

dnf5 -y config-manager setopt \
    '*fedora*'.exclude='mesa-* kernel-core-* kernel-modules-* kernel-uki-virt-* steam noopenh264'
dnf5 -y config-manager setopt \
    'updates*'.exclude='mesa-* kernel-core-* kernel-modules-* kernel-uki-virt-* steam noopenh264'

# dnf5 -y config-manager setopt '*audinux*'.exclude='kernel*'
dnf5 -y config-manager setopt \
    '*staging*'.exclude='scx-tools scx-scheds kf6-* mesa* mutter*'

# Must run after the '*fedora*' exclude: COPR repo IDs contain
# "copr.fedorainfracloud.org", so that glob matches them too, and
# config-manager overwrites (not merges) a repo's exclude value.
dnf5 -y config-manager setopt '*bazzite*'.exclude='NetworkManager*'

#!/usr/bin/env bash

set -Eeuo pipefail

# Read package list from packages.json
PACKAGES_JSON="/ctx/packages.json"
if [[ ! -f "$PACKAGES_JSON" ]]; then
    echo "ERROR: packages.json not found at $PACKAGES_JSON" >&2
    exit 1
fi

copr='aahsnr-work/gaming'
repo_id="copr:copr.fedorainfracloud.org:${copr////:}"
copr_enabled=0

disable_copr() {
    if ((copr_enabled)); then
        if ! dnf5 -y copr disable "$copr"; then
            printf 'ERROR: failed to disable COPR %s\n' "$copr" >&2
            return 1
        fi
        copr_enabled=0
    fi
}
trap 'disable_copr || true' EXIT

# Remove packages that conflict with gaming stack
for pkg in pipewire-config-raop mesa-va-drivers; do
    if rpm -q "$pkg" >/dev/null 2>&1; then
        dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y remove "$pkg"
    fi
done

# Swap wireplumber to terra-wireplumber
dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y swap --allowerasing --repo terra-extras wireplumber terra-wireplumber

# Mesa: every package below must come from one repository at one EVR, on both
# arches. Mesa subpackages require each other's exact EVR, and dnf5 rejects an
# implicitly pulled i686 package whose EVR differs from its installed x86_64
# sibling ("has inferior architecture"). terra-mesa publishes each arch on its
# own schedule and keeps only the newest build, so its x86_64 and i686 EVRs can
# differ. Use the newest EVR terra-mesa ships for every package; when there is
# none, fall back to fedora-multimedia (negativo17, what base-main ships).
mesa_specs=(
    mesa-filesystem.x86_64
    mesa-dri-drivers.x86_64
    mesa-libEGL.x86_64
    mesa-libGL.x86_64
    mesa-libgbm.x86_64
    mesa-vulkan-drivers.x86_64
    mesa-libGL-devel.x86_64
    mesa-libgbm-devel.x86_64
    mesa-filesystem.i686
    mesa-dri-drivers.i686
    mesa-libEGL.i686
    mesa-libGL.i686
    mesa-libgbm.i686
    mesa-vulkan-drivers.i686
)

# Print the newest EVR that $mesa_repo ships for every entry of mesa_specs.
common_mesa_evr() {
    local spec
    for spec in "${mesa_specs[@]}"; do
        dnf5 -q repoquery --repo="$mesa_repo" "${mesa_repo_opts[@]}" \
            --qf '%{epoch}:%{version}-%{release}\n' "$spec" | sort -u
    done | sort | uniq -c | awk -v n="${#mesa_specs[@]}" '$1 == n { print $2 }' | sort -V | tail -n 1
}

mesa_repo=terra-mesa
mesa_repo_opts=()
mesa_evr=$(common_mesa_evr)
if [[ -z "$mesa_evr" ]]; then
    terra_mesa_evrs=$(dnf5 -q repoquery --repo=terra-mesa \
        --qf '%{name}.%{arch} %{epoch}:%{version}-%{release}\n' "${mesa_specs[@]}")
    printf 'WARNING: terra-mesa has no Mesa EVR shared by every required package:\n' >&2
    printf '  %s\n' "${terra_mesa_evrs//$'\n'/$'\n'  }" >&2
    printf 'WARNING: installing all Mesa packages from fedora-multimedia instead\n' >&2
    mesa_repo=fedora-multimedia
    mesa_repo_opts=(--setopt=disable_excludes=fedora-multimedia)
    mesa_evr=$(common_mesa_evr)
    if [[ -n "$mesa_evr" ]]; then
        # GitHub Actions workflow command: shows the fallback on the run
        # summary. It goes away on its own once terra-mesa publishes one EVR
        # for both arches.
        printf '::warning title=Mesa from fedora-multimedia::terra-mesa has no Mesa EVR common to x86_64 and i686 (%s); installing Mesa %s from fedora-multimedia\n' \
            "$(awk '{ sub(/.*\./, "", $1); print $1 " " $2 }' <<<"$terra_mesa_evrs" | sort -u | paste -sd ',' | sed 's/,/, /g')" \
            "$mesa_evr"
    fi
fi
if [[ -z "$mesa_evr" ]]; then
    printf 'ERROR: neither terra-mesa nor fedora-multimedia ships one Mesa EVR for: %s\n' "${mesa_specs[*]}" >&2
    exit 1
fi
printf 'Installing Mesa %s from %s\n' "$mesa_evr" "$mesa_repo"

# Explicit versions make dnf5 upgrade or downgrade both arches in one transaction.
mesa_nevras=()
for spec in "${mesa_specs[@]}"; do
    mesa_nevras+=("${spec%.*}-${mesa_evr}.${spec##*.}")
done
dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' "${mesa_repo_opts[@]}" \
    -y install --allowerasing --from-repo="$mesa_repo" "${mesa_nevras[@]}"

# Packages already at that EVR from another repository (base-main ships
# negativo17 builds) are left alone by install; reinstall them from $mesa_repo.
mapfile -t mesa_foreign < <(
    dnf5 -q repoquery --installed --qf '%{name}.%{arch} %{from_repo}\n' "${mesa_specs[@]}" |
        awk -v repo="$mesa_repo" '$2 != repo { print $1 }'
)
if ((${#mesa_foreign[@]})); then
    dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' "${mesa_repo_opts[@]}" \
        -y reinstall --from-repo="$mesa_repo" "${mesa_foreign[@]}"
fi

# Swap bluez and Xwayland to patched bazzite-multilib builds
for package in bluez xorg-x11-server-Xwayland; do
    dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y swap --from-repo="copr:copr.fedorainfracloud.org:ublue-os:bazzite-multilib" "$package" "$package"
done

# Enable aahsnr-work/gaming at priority=1 to install protonplus, then disable immediately
dnf5 -y copr enable "$copr"
copr_enabled=1
dnf5 -y config-manager setopt "${repo_id}.priority=1"

# Read packages from packages.json
mapfile -t gaming_packages < <(jq -r '."gaming".packages[]' "$PACKAGES_JSON")
mapfile -t removal_packages < <(jq -r '."gaming".removals[]' "$PACKAGES_JSON")

# Install gaming packages from COPR (protonplus, heroic-games-launcher)
dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' \
    -y install protonplus heroic-games-launcher

disable_copr

# Codecs, OpenCL, and graphics headers (Mesa itself is pinned above)
dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' --enable-repo=terra-mesa -y install \
    mesa-libGLES-devel \
    glslang-devel \
    intel-opencl \
    clinfo
dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y install libfreeaptx
dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y install --enable-repo='*fedora-multimedia*' --allowerasing \
    openh264.x86_64 \
    openh264.i686

# Gaming middleware, Steam, and Lutris
dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y install dmemcg-booster

dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' --enable-repo=terra-mesa --enable-repo=terra --enable-repo=terra-extras \
    -y install "${gaming_packages[@]}"

dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y --enable-repo=terra-mesa --enable-repo=terra \
    install steam lutris

# Remove unwanted packages
for pkg in "${removal_packages[@]}"; do
    if rpm -q "$pkg" >/dev/null 2>&1; then
        dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y remove "$pkg"
    fi
done

# Versionlock core graphics and system packages
mapfile -t versionlocked_packages < <(jq -r '."gaming".versionlocks[]' "$PACKAGES_JSON")
dnf5 versionlock add "${versionlocked_packages[@]}"

# Install the pinned winetricks (downloads stage) and mark component attribute
install -D -m 0755 /downloads/winetricks /usr/bin/winetricks
setfattr -n user.component -v winetricks /usr/bin/winetricks 2>/dev/null || true

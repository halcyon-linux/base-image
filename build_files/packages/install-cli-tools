#!/usr/bin/env bash

set -Eeuo pipefail

# Read package list from packages.json
PACKAGES_JSON="/ctx/packages.json"
if [[ ! -f "$PACKAGES_JSON" ]]; then
    echo "ERROR: packages.json not found at $PACKAGES_JSON" >&2
    exit 1
fi

copr='aahsnr-work/cli-tools'
repo_id="copr:copr.fedorainfracloud.org:${copr////:}"
copr_enabled=0

disable_copr() {
    local status=$?
    trap - EXIT
    if ((copr_enabled)); then
        if ! dnf5 -y copr disable "$copr"; then
            printf 'ERROR: failed to disable COPR %s\n' "$copr" >&2
            status=1
        fi
    fi
    exit "$status"
}
trap disable_copr EXIT

dnf5 -y copr enable "$copr"
copr_enabled=1
dnf5 -y config-manager setopt "${repo_id}.priority=1"

# Read packages from packages.json
mapfile -t cli_tools_packages < <(jq -r '."cli-tools".packages[]' "$PACKAGES_JSON")

# `dnf5 install` leaves a package that is already installed from another repo
# (the base image ships some, e.g. fzf) as it is, so remove every such copy
# first; the install below then takes the COPR build. The final `verify`
# checks the source repo of each package again.
foreign=()
while read -r name from_repo; do
    if [[ "$from_repo" != "$repo_id" ]]; then
        foreign+=("$name")
    fi
done < <(dnf5 repoquery --installed --qf '%{name} %{from_repo}\n' "${cli_tools_packages[@]}")
if ((${#foreign[@]})); then
    printf 'Replacing non-COPR cli-tools packages: %s\n' "${foreign[*]}"
    dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y remove "${foreign[@]}"
fi

# Terra ships a newer fzy release (fzy-1.1-2.fc44), so it has to be pushed
# behind the COPR or it shadows the cli-tools build.
dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' \
    --setopt='*terra*'.priority=10 \
    -y install "${cli_tools_packages[@]}"

#!/usr/bin/env bash
set -Eeuo pipefail

# btop replaces htop, uupd replaces the upstream update service, and the base
# image's CJK font isn't needed on this device (nothing requires or recommends
# it, so removal doesn't cascade). fish is removed because zsh is the designated
# default shell; greetd is removed because sddm is the display manager;
# auxiliary zsh packages are removed because only the standalone zsh package is allowed.
# Handheld-specific packages and unnecessary kmod-related packages are trimmed.
for pkg in \
    htop ublue-os-update-services google-noto-sans-cjk-fonts fish greetd greetd-selinux \
    zsh-autosuggestions zsh-syntax-highlighting \
    jupiter-fan-control jupiter-hw-support-btrfs jupiter-sd-mounting-btrfs \
    steamdeck-dsp steamdeck-backgrounds steamdeck-gnome-presets steamdeck-kde-presets \
    inputplumber steamos-manager-powerstation steamos-manager \
    gamescope-session-ogui-steam powerbuttond vpower sdgyrodsu galileo-mura; do
    if rpm -q "$pkg" >/dev/null 2>&1; then
        dnf5 --setopt=install_weak_deps=False --setopt='*.skip_if_unavailable=False' -y remove "$pkg"
    fi
done

# Wipe any residual fish shell configuration or integration directories
rm -rf /etc/fish /usr/share/fish


#!/usr/bin/env bash

# Install Fedora's TeX Live medium scheme and set the system paper size to Letter.

set -Eeuo pipefail

PACKAGES_JSON="/ctx/packages.json"
if [[ ! -f "$PACKAGES_JSON" ]]; then
    echo "ERROR: packages.json not found at $PACKAGES_JSON" >&2
    exit 1
fi

mapfile -t PACKAGES < <(jq -er '.texlive.packages[]' "$PACKAGES_JSON")
dnf5 -y install --from-repo=fedora,updates --setopt=install_weak_deps=False "${PACKAGES[@]}"
texconfig-sys paper letter

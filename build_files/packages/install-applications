#!/usr/bin/env bash

# Enable aahsnr-work/applications COPR at priority=1 and install desktop applications and bees deduplication daemon.
# Install developer tools (vscode, vscodium) and web browsers (firefox, brave, brave-origin, chrome, edge, vivaldi)
# following strict repository lifecycle: enable with priority=1 and weak deps disabled, install, disable repo.

set -Eeuo pipefail

# Read package list from packages.json
PACKAGES_JSON="/ctx/packages.json"
if [[ ! -f "$PACKAGES_JSON" ]]; then
    echo "ERROR: packages.json not found at $PACKAGES_JSON" >&2
    exit 1
fi

copr='aahsnr-work/applications'
repo_id="copr:copr.fedorainfracloud.org:${copr////:}"

declare -a ENABLED_COPRS=()
declare -a ENABLED_REPOS=()

cleanup_repos() {
    local status=$?
    trap - EXIT
    for c in "${ENABLED_COPRS[@]}"; do
        echo "Disabling COPR: $c"
        dnf5 -y copr disable "$c" 2>/dev/null || true
    done
    for r in "${ENABLED_REPOS[@]}"; do
        echo "Disabling repository: $r"
        dnf5 -y config-manager setopt "${r}.enabled=0" 2>/dev/null || true
    done
    exit "$status"
}
trap cleanup_repos EXIT

# Ensure /opt is a real directory rather than a symlink to /var/opt.
# Fedora Atomic base images ship /opt -> var/opt; replacing it with a directory avoids
# cpio unpack errors ('File exists' / 'No such file or directory') when installing RPMs
# that deliver files into /opt, and ensures application payloads are retained by bootc.
if [[ -L /opt ]]; then
    rm -f /opt
    mkdir -p /opt
    chmod 0755 /opt
fi

COMMON_INSTALL_OPTS=(
    --setopt='*terra*'.priority=10
    --setopt=install_weak_deps=False
    --setopt='*.skip_if_unavailable=False'
)

# -----------------------------------------------------------------------------
# STEP 1: Enable aahsnr-work/applications COPR
# -----------------------------------------------------------------------------
dnf5 -y copr enable "$copr"
ENABLED_COPRS+=("$copr")

repo_status=$(dnf5 repo list --all | awk -v id="$repo_id" '$1 == id { print $NF }')
if [[ "$repo_status" != "enabled" ]]; then
    echo "ERROR: ${repo_id} not found or not enabled (status: '${repo_status}')" >&2
    exit 1
fi

COPR_INSTALL_OPTS=(
    --setopt="${repo_id}.priority=1"
    "${COMMON_INSTALL_OPTS[@]}"
)

# -----------------------------------------------------------------------------
# STEP 2: Read COPR packages from packages.json
# -----------------------------------------------------------------------------
mapfile -t COPR_PACKAGES < <(jq -r '."applications".copr_packages[]' "$PACKAGES_JSON")

echo "Installing packages from ${copr}..."
dnf5 -y install "${COPR_INSTALL_OPTS[@]}" "${COPR_PACKAGES[@]}"

# Disable COPR immediately after successful install
dnf5 -y copr disable "$copr"
ENABLED_COPRS=()

repo_status=$(dnf5 repo list --all | awk -v id="$repo_id" '$1 == id { print $NF }')
if [[ "$repo_status" != "disabled" ]]; then
    echo "ERROR: ${repo_id} is still enabled according to dnf5 repo list (status: '${repo_status}')" >&2
    exit 1
fi

repo_file=$(compgen -G "/etc/yum.repos.d/*${copr////:}*.repo" || compgen -G "/etc/yum.repos.d/*${copr////-}*.repo" || true)
if [[ -n "$repo_file" && -f "$repo_file" ]]; then
    if ! grep -qE '^enabled\s*=\s*0' "$repo_file"; then
        echo "ERROR: ${repo_file} does not have enabled=0" >&2
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# STEP 3: Install Fedora repository packages (firefox, neovim)
# -----------------------------------------------------------------------------
mapfile -t FEDORA_PACKAGES < <(jq -r '."applications".fedora_packages[]' "$PACKAGES_JSON")

echo "Installing Fedora repository packages..."
dnf5 -y install "${COMMON_INSTALL_OPTS[@]}" "${FEDORA_PACKAGES[@]}"
rpm -q "${FEDORA_PACKAGES[@]}"

# -----------------------------------------------------------------------------
# STEP 4: Install external repository packages (VS Code, VSCodium, browsers)
# -----------------------------------------------------------------------------
# Read external repos from packages.json
EXTERNAL_REPOS_COUNT=$(jq '.["applications"].external_repos | length' "$PACKAGES_JSON")

for ((i=0; i<EXTERNAL_REPOS_COUNT; i++)); do
    ext_id=$(jq -r ".applications.external_repos[$i].id" "$PACKAGES_JSON")
    repo_name=$(jq -r ".applications.external_repos[$i].name" "$PACKAGES_JSON")
    repo_baseurl=$(jq -r ".applications.external_repos[$i].baseurl" "$PACKAGES_JSON")
    repo_gpgkey=$(jq -r ".applications.external_repos[$i].gpgkey" "$PACKAGES_JSON")
    mapfile -t repo_fingerprints < <(jq -er ".applications.external_repos[$i].gpg_fingerprints[]" "$PACKAGES_JSON")
    mapfile -t repo_packages < <(jq -r ".applications.external_repos[$i].packages[]" "$PACKAGES_JSON")

    echo "Configuring ${repo_name} repository..."
    cat <<EOF >"/etc/yum.repos.d/${ext_id}.repo"
[${ext_id}]
name=${repo_name}
baseurl=${repo_baseurl}
enabled=1
gpgcheck=1
gpgkey=${repo_gpgkey}
EOF

    # Import the vendor key only after every primary key in it matches the
    # fingerprints pinned in packages.json; a rotated key fails the build.
    repo_keyfile=$(mktemp)
    curl --proto =https --proto-redir =https --fail --retry 3 --retry-delay 2 --retry-max-time 60 \
        -sSL -o "$repo_keyfile" "$repo_gpgkey"
    /ctx/shared/check-gpg-fingerprints "$repo_keyfile" "${repo_fingerprints[@]}"
    rpm --import "$repo_keyfile"
    rm -f "$repo_keyfile"
    ENABLED_REPOS+=("${ext_id}")

    echo "Installing ${repo_name} packages..."
    dnf5 -y install --setopt="${ext_id}.priority=1" "${COMMON_INSTALL_OPTS[@]}" "${repo_packages[@]}"
    rpm -q "${repo_packages[@]}"

    echo "Disabling repository: ${ext_id}"
    dnf5 -y config-manager setopt "${ext_id}.enabled=0"
    sed -i 's/^enabled\s*=.*/enabled=0/' "/etc/yum.repos.d/${ext_id}.repo"
    ENABLED_REPOS=()
done

# -----------------------------------------------------------------------------
# STEP 5: Package verification and repository status scan
# -----------------------------------------------------------------------------
# Collect all packages for verification
ALL_PACKAGES=("${COPR_PACKAGES[@]}" "${FEDORA_PACKAGES[@]}")
for ((i=0; i<EXTERNAL_REPOS_COUNT; i++)); do
    mapfile -t repo_packages < <(jq -r ".applications.external_repos[$i].packages[]" "$PACKAGES_JSON")
    ALL_PACKAGES+=("${repo_packages[@]}")
done

echo "Verifying installation of all requested application packages..."
rpm -q "${ALL_PACKAGES[@]}"

# Assert all third-party repos report disabled in dnf5 repo list
REPO_IDS_TO_CHECK=("$repo_id")
for ((i=0; i<EXTERNAL_REPOS_COUNT; i++)); do
    REPO_IDS_TO_CHECK+=("$(jq -r ".applications.external_repos[$i].id" "$PACKAGES_JSON")")
done

for check_repo in "${REPO_IDS_TO_CHECK[@]}"; do
    status="$(dnf5 repo list --all | awk -v id="$check_repo" '$1 == id { print $NF }')"
    if [[ "$status" != "disabled" ]]; then
        echo "ERROR: Repository $check_repo is still reported as '${status}' (must be disabled)" >&2
        exit 1
    fi
done

# Filesystem check: summarize files under /opt or /var (browsers and office suites ship thousands)
for pkg in "${ALL_PACKAGES[@]}"; do
    opt_or_var=$(rpm -ql "$pkg" 2>/dev/null | grep -E '^/(opt|var)' || true)
    if [[ -n "$opt_or_var" ]]; then
        count=$(wc -l <<<"$opt_or_var")
        dirs=$(cut -d/ -f1-3 <<<"$opt_or_var" | sort -u | paste -sd' ' -)
        echo "INFO: Package $pkg ships ${count} path(s) under /opt or /var: ${dirs}"
    fi
done

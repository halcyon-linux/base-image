#!/usr/bin/env bash

set -Eeuo pipefail

die() {
    printf 'ERROR: %s\n' "${*:-Something went wrong}" >&2
    exit 1
}

_usage() {
    local -i status=${1:-0}
    printf >&2 'Usage: %s <setopt|unsetopt> <repo_name|repo_id> <option>=<value> [...]\n' "$(basename "$0")"
    return $status
}

while getopts "h" opt; do
    case $opt in
    h)
        _usage 0
        exit
        ;;
    *) ;;
    esac
done

action=${1:-}
[[ -n "$action" ]] || die "Missing action"
shift

case $action in
setopt | unsetopt) ;;
*)
    die "Only setopt|unsetopt are allowed as first parameter"
    ;;
esac

selector=${1:-}
[[ -n "$selector" ]] || die "Missing repository selector"
shift

IFS=',' read -r -a selectors <<<"$selector"
repo_json="$(dnf5 repo info --all --json "${selectors[@]}")" || die "Failed to query repositories"
repo_ids="$(jq -r '.[].id' <<<"$repo_json")" || die "Failed to parse repository list"
if [[ -z "$repo_ids" ]]; then
    die "No repo found matching '$selector'"
fi
mapfile -t repos <<<"$repo_ids"

options=()
while (($#)); do
    [[ -n "$1" ]] || die "Empty option"
    options+=("$1")
    shift
done

if [[ ${#options[@]} -eq 0 ]]; then
    die "No options were provided"
fi

arguments=()
for repo in "${repos[@]}"; do
    for option in "${options[@]}"; do
        arguments+=("$repo.$option")
    done
done

dnf5 config-manager "$action" "${arguments[@]}"

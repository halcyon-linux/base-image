#!/usr/bin/env bash

set -Eeuo pipefail

# Prepare /var/tmp.
mkdir -p /var/tmp
chmod 1777 /var/tmp

# Symlink Direct Rendering Manager libraries.
if [[ -e /usr/lib/libdrm.so.2 ]]; then
    cp --no-dereference --preserve=links /usr/lib/libdrm.so.2 /usr/lib/libdrm.so
fi
if [[ -e /usr/lib64/libdrm.so.2 ]]; then
    cp --no-dereference --preserve=links /usr/lib64/libdrm.so.2 /usr/lib64/libdrm.so
fi

# Hide CLI utilities from graphical application menus.
for app in nvtop btop yad-icon-browser; do
    if [[ -f "/usr/share/applications/${app}.desktop" ]]; then
        desktop-file-edit --set-key=Hidden --set-value=true "/usr/share/applications/${app}.desktop"
    fi
done

# Enable UserspaceHID for Bluetooth gamepads and patch GRUB's OSTree device probing.
if [[ -f /etc/bluetooth/input.conf ]]; then
    sed -i 's/#UserspaceHID.*/UserspaceHID=true/' /etc/bluetooth/input.conf
fi
if [[ -f /usr/bin/grub2-mkconfig ]]; then
    sed -i "s|grub_probe\} --target=device /\`|grub_probe} --target=device /sysroot\`|g" \
        /usr/bin/grub2-mkconfig
fi

# Prevent Steam from autostarting on user login.
rm -f \
    /etc/skel/.config/autostart/steam.desktop \
    /etc/xdg/autostart/steam.desktop \
    /usr/share/autostart/steam.desktop

# Set zsh as the default login shell.
# 1. Ensure /etc/shells contains the zsh path (it should already be there
#    after the zsh RPM install, but be explicit).
if [[ -x /usr/bin/zsh ]] && ! grep -qxF /usr/bin/zsh /etc/shells 2>/dev/null; then
    echo /usr/bin/zsh >> /etc/shells
fi

# 2. Configure useradd so newly created accounts get zsh.
if [[ -f /etc/default/useradd ]]; then
    sed -i 's|^SHELL=.*|SHELL=/usr/bin/zsh|' /etc/default/useradd
else
    printf '[useradd]\nSHELL=/usr/bin/zsh\n' > /etc/default/useradd
fi

# 3. Change root's default shell to zsh so the skeleton applies consistently.
if [[ -x /usr/bin/zsh ]]; then
    usermod --shell /usr/bin/zsh root 2>/dev/null || \
        sed -i 's|^root:.*|root:x:0:0:root:/root:/usr/bin/zsh|' /etc/passwd
fi

# 4. Ensure /etc/skel has a minimal .zshrc that sources the zsh-preexec
#    compatibility shim.
mkdir -p /etc/skel
cat > /etc/skel/.zshrc << 'ZSHRC'
# /etc/skel/.zshrc — Halcyon default Zsh configuration
# Source zsh-preexec compatibility shim (bash-preexec API for zsh)
[[ -f /usr/share/zsh/site-functions/zsh-preexec.zsh ]] && \
    source /usr/share/zsh/site-functions/zsh-preexec.zsh
ZSHRC

# 5. Setup GUI pinentry with console/TTY fallback and configure GPG agent skeleton.
cat > /usr/bin/pinentry-wrapper << 'WRAPPER'
#!/usr/bin/env bash
# Halcyon pinentry dispatcher:
# Automatically selects GUI pinentry (pinentry-gnome3) when a graphical session
# (Wayland or X11) is active; falls back to pinentry-curses or pinentry-tty
# when running in a console, TTY, or SSH session.

if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
    if [[ -x /usr/bin/pinentry-gnome3 ]]; then
        exec /usr/bin/pinentry-gnome3 "$@"
    fi
fi

if [[ -x /usr/bin/pinentry-curses ]]; then
    exec /usr/bin/pinentry-curses "$@"
elif [[ -x /usr/bin/pinentry-tty ]]; then
    exec /usr/bin/pinentry-tty "$@"
fi

exec /usr/bin/pinentry "$@"
WRAPPER
chmod 0755 /usr/bin/pinentry-wrapper

mkdir -p /etc/skel/.gnupg
chmod 0700 /etc/skel/.gnupg
cat > /etc/skel/.gnupg/gpg-agent.conf << 'GPGCONF'
# /etc/skel/.gnupg/gpg-agent.conf — Halcyon default GPG agent configuration
pinentry-program /usr/bin/pinentry-wrapper
default-cache-ttl 28800
max-cache-ttl 86400
GPGCONF
chmod 0600 /etc/skel/.gnupg/gpg-agent.conf


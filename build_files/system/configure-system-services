#!/usr/bin/env bash

set -Eeuo pipefail

system_services=(
    input-remapper.service
    uupd.timer
    hardware-setup.service
    dev-hugepages1G.mount
    libvirtd.service
    ds-inhibit.service
    greenboot-healthcheck.service
    greenboot-set-rollback-trigger.service
    dmemcg-booster-system.service
    cardwired.service
    sddm.service
    cups.service
    var-nix.service
    nix.mount
    nix-daemon.socket
    nix-daemon.service
)

global_services=(
    user-setup.service
    podman.socket
    systemd-tmpfiles-setup.service
    dynamic-fixes.service
    dmemcg-booster-user.service
    chezmoi-init.service
    chezmoi-update.timer
    apply-gtk-themes.service
)

disabled_services=(
    scx_loader.service
    rpm-ostreed-automatic.timer
    tailscaled.service
    greetd.service
)

for unit in "${system_services[@]}"; do
    systemctl enable "$unit"
done

for unit in "${global_services[@]}"; do
    systemctl --global enable "$unit"
done

for unit in "${disabled_services[@]}"; do
    systemctl disable "$unit" 2>/dev/null || true
done

systemctl set-default graphical.target

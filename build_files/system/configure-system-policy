#!/usr/bin/env bash

set -Eeuo pipefail

# Disable rpm-ostree automatic staging; updates are managed by uupd.
if [[ -f /etc/rpm-ostreed.conf ]]; then
    sed -i -E 's/^([[:space:]]*AutomaticUpdatePolicy[[:space:]]*=).*/\1none/' \
        /etc/rpm-ostreed.conf
fi

# Disable external build repositories in the shipping image.
repositories=(
    fedora-cisco-openh264
    tailscale
    gh-cli
    _copr_ublue-os-akmods
    terra
    terra-extras
    negativo17-fedora-multimedia
    vscode
    vscodium
    brave-browser
    google-chrome
    microsoft-edge
    vivaldi
)
for repo in "${repositories[@]}"; do
    if [[ -f "/etc/yum.repos.d/${repo}.repo" ]]; then
        sed -i 's@enabled=1@enabled=0@g' "/etc/yum.repos.d/${repo}.repo"
    fi
done

coprs=(
    ublue-os/bazzite
    ublue-os/bazzite-multilib
    ublue-os/staging
    ublue-os/packages
)
# Keep this list synchronized with setup-repositories. Repositories not
# enabled by this build do not belong in the disable list. Nerd Fonts remain
# excluded from Terra and forbidden by final verification.
for copr in "${coprs[@]}"; do
    repo_id="copr:copr.fedorainfracloud.org:${copr////:}"
    dnf5 -y config-manager setopt "${repo_id}.enabled=0"
done
unset -v copr repo_id

# Disable the inherited negativo17 repository when it exists; propagate DNF
# errors rather than hiding a failed repository update.
all_repos="$(dnf5 repo info --all --json)"
negativo17_repos="$(jq '[.[] | select(.id | contains("negativo17"))]' <<<"$all_repos")"
if jq -e 'length > 0' <<<"$negativo17_repos" >/dev/null; then
    /ctx/shared/dnf5-setopt setopt '*negativo17*' enabled=0
fi

# Patch setroubleshoot's SELinux configuration path.
for util_file in /usr/lib/python3.*/site-packages/setroubleshoot/util.py; do
    if [[ -f "$util_file" ]]; then
        sed -i 's#/var/lib/selinux#/etc/selinux#g' "$util_file"
    fi
done

# Configure Bazzite's Tuned power profile mappings.
if [[ -f /etc/tuned/ppd.conf ]]; then
    sed -i 's/power-saver=powersave$/power-saver=powersave-bazzite/' /etc/tuned/ppd.conf
    sed -i 's/balanced=balanced$/balanced=balanced-bazzite/' /etc/tuned/ppd.conf
    sed -i 's/performance=throughput-performance$/performance=throughput-performance-bazzite/' \
        /etc/tuned/ppd.conf
fi

# Prevent applications from starting a separate PulseAudio server.
ln -sfn /usr/bin/true /usr/bin/pulseaudio

# Install Bazzite Firefox preferences for the RPM Firefox.
firefox_config=/usr/share/ublue-os/firefox-config
if [[ -d "$firefox_config" ]] && compgen -G "$firefox_config"/*.js >/dev/null; then
    install -d /usr/lib64/firefox/defaults/pref
    cp "$firefox_config"/*.js /usr/lib64/firefox/defaults/pref/
fi

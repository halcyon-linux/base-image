[Unit]
Description=Chezmoi Dotfiles Periodic Update
ConditionUser=!@system
ConditionUser=!sddm
# Opt-in: `ujust dotfiles enable` creates the flag (see README, Dotfiles with chezmoi).
ConditionPathExists=%h/.config/halcyon/chezmoi-enable
ConditionPathExists=%h/.local/share/chezmoi/.git/

[Service]
Type=oneshot
ExecStart=/usr/bin/chezmoi update --no-tty --force
TimeoutStartSec=600


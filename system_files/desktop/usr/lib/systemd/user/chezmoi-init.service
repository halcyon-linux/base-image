[Unit]
Description=Initialize chezmoi dotfiles from aahsnr-configs/dotfiles
ConditionUser=!@system
ConditionUser=!sddm
ConditionPathExists=!%h/.local/share/chezmoi/.git/

[Service]
Type=oneshot
# --ssh: clone over SSH (git@github.com). The plain github.com identity is the
# aahsnr-configs key, provided system-wide by
# /etc/ssh/ssh_config.d/10-halcyon-github.conf so the initial clone also works
# on fresh machines (the repo does not exist yet to carry core.sshCommand).
ExecStart=/usr/bin/chezmoi init --apply --force --ssh aahsnr-configs/dotfiles
# The working copy lives outside git-setup's includeIf tree (~/Git/<account>),
# so pin the aahsnr-configs SSH command into the repo itself (idempotent;
# matches the per-account setup of ~/.bin/git-setup).
ExecStartPost=/usr/bin/git -C %h/.local/share/chezmoi config core.sshCommand "ssh -i %h/.ssh/id_ed25519_aahsnr_configs -o IdentitiesOnly=yes -o AddKeysToAgent=yes"
Restart=on-failure
RestartSec=15s
StartLimitIntervalSec=5m
StartLimitBurst=5
TimeoutStartSec=600

[Install]
WantedBy=default.target


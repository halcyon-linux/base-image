[Unit]
Description=Initialize chezmoi dotfiles from aahsnr-configs/dotfiles
ConditionUser=!@system
ConditionUser=!sddm
ConditionPathExists=!%h/.local/share/chezmoi/.git/

[Service]
Type=oneshot
ExecStart=/usr/bin/chezmoi init --apply --force aahsnr-configs/dotfiles
Restart=on-failure
RestartSec=15s
StartLimitIntervalSec=5m
StartLimitBurst=5
TimeoutStartSec=600

[Install]
WantedBy=default.target


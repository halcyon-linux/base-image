[Unit]
Description=Halcyon: SELinux policy modules and service posture
After=local-fs.target
# semodule needs a running SELinux policy; skip cleanly when it is not loaded.
ConditionSecurity=selinux

[Service]
Type=oneshot
ExecStart=/usr/bin/halcyon-security-posture

[Install]
WantedBy=multi-user.target

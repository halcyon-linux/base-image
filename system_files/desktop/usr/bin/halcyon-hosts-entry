#!/usr/bin/env bash
# Halcyon: ensure the system hostname resolves via /etc/hosts (Lynis NAME-4404)
# and carries a DNS domain (Lynis NAME-4028). The entry is
# `127.0.1.1 <host>.localdomain <host>`: glibc reports the first name as the
# canonical one, so `dnsdomainname` returns `localdomain`. The entry uses
# 127.0.1.1 rather than the localhost lines, which NAME-4406 forbids mapping
# the hostname onto. Idempotent; an older entry without the domain is replaced.
set -euo pipefail

host=$(hostname)
[[ -n "$host" ]] || exit 0

fqdn="${host}.localdomain"
entry=$(printf '127.0.1.1\t%s %s' "$fqdn" "$host")

if grep -qxF -- "$entry" /etc/hosts; then
    exit 0
fi

# Drop a previous 127.0.1.1 line for this host (no domain), then append.
tmp=$(mktemp)
awk -v host="$host" '
    $1 == "127.0.1.1" && NF == 2 && $2 == host { next }
    { print }
' /etc/hosts > "$tmp"
printf '%s\n' "$entry" >> "$tmp"
cat "$tmp" > /etc/hosts
rm -f "$tmp"

#!/usr/bin/env bash
# Halcyon security posture, applied at boot (idempotent):
#
# 1. Install the secureblue SELinux socket-class restrictions (Apache-2.0/MIT,
#    https://github.com/secureblue/secureblue): userspace is denied access to
#    the kernel crypto API (AF_ALG), IPSec, obscure, and packet-radio sockets.
#    These are installed at runtime rather than build time because the SELinux
#    policy store lives in /var, which bootc does not refresh on image updates.
#    A checksum stamp of the shipped .cil files makes an updated image replace
#    the modules it previously installed.
# 2. Keep services that a single-user desktop does not need turned off, even
#    after package transactions re-enable them.
set -euo pipefail

# --- SELinux socket policies ---------------------------------------------
policy_dir=/usr/share/halcyon/selinux
policies=(secureblue_socket_utils secureblue_audit_sockets secureblue_deny_alg_sockets secureblue_deny_ipsec_sockets secureblue_deny_obscure_sockets secureblue_deny_packet_radio_sockets)
stamp=/var/lib/halcyon/selinux-socket-policies.sha256

cil_files=()
for policy in "${policies[@]}"; do
    cil_files+=("${policy_dir}/${policy}.cil")
done

want=$(cat "${cil_files[@]}" | sha256sum | cut -d' ' -f1)
have=$(cat "$stamp" 2>/dev/null || true)

# Capture once: one semodule run instead of six, and no pipe for grep -q to
# close early under pipefail.
modules=$(semodule -l)
missing=0
for policy in "${policies[@]}"; do
    if ! grep -qx -- "$policy" <<<"$modules"; then
        missing=$((missing + 1))
    fi
done

if ((missing > 0)) || [[ "$want" != "$have" ]]; then
    echo "halcyon-security-posture: installing SELinux socket policy modules (${missing} missing, stamp $([[ "$want" == "$have" ]] && echo current || echo stale))"
    # Priority 300: above RPM-shipped policies (200), below local admin ones (400)
    semodule -v -X 300 -i "${cil_files[@]}"
    mkdir -p "$(dirname "$stamp")"
    printf '%s\n' "$want" >"$stamp"
fi

# --- Service posture ------------------------------------------------------
# authselect is 'local' on this image: sssd is not part of authentication.
systemctl disable \
    sssd.service sssd-kcm.service sssd-kcm.socket \
    ModemManager.service \
    iscsid.service iscsid.socket iscsiuio.service iscsiuio.socket \
    alsa-state.service 2>/dev/null || true
# passim is D-Bus-activatable; only a mask keeps it from respawning (fwupd
# degrades gracefully without it).
systemctl mask passim.service 2>/dev/null || true

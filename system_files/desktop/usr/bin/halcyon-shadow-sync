#!/usr/bin/env bash
# Halcyon: keep /etc/gshadow consistent with /etc/group (Lynis AUTH-9216).
#
# bootc splits the user database: system groups live in /usr/lib/group (nss
# "altfiles" merge) while /etc/group holds only root, wheel, and runtime
# accounts. shadow-utils' usermod resolves groups through nss but writes only
# /etc/group, so `usermod -aG <usr-group> <user>` leaves /etc/gshadow without a
# matching entry and grpck (which reads only the /etc pair) reports errors.
#
# This syncs /etc/gshadow to /etc/group: entries for groups no longer in
# /etc/group are dropped, missing entries are added with a locked password, and
# member lists are taken from /etc/group (grpck requires both files to agree).
# Group passwords and administrators already present in /etc/gshadow are kept.
# Nothing is rewritten when grpck is already silent.
set -euo pipefail

if [[ -z "$(grpck -r 2>&1)" ]]; then
    exit 0
fi

tmp=$(mktemp /etc/gshadow.sync.XXXXXX)
trap 'rm -f "$tmp"' EXIT

awk -F: '
    NR==FNR {
        if (NF == 4) { order[++n] = $1; members[$1] = $4 }
        next
    }
    {
        if (NF == 4) { gpw[$1] = $2; gadmin[$1] = $3 }
    }
    END {
        for (i = 1; i <= n; i++) {
            name = order[i]
            pw = (name in gpw && gpw[name] != "") ? gpw[name] : "!"
            admin = (name in gadmin) ? gadmin[name] : ""
            printf "%s:%s:%s:%s\n", name, pw, admin, members[name]
        }
    }
' /etc/group /etc/gshadow > "$tmp"

# Rewrite in place: cat keeps the inode, so the 0000 mode and SELinux label of
# /etc/gshadow survive.
cat "$tmp" > /etc/gshadow
rm -f "$tmp"
trap - EXIT

if [[ -n "$(grpck -r 2>&1)" ]]; then
    echo "ERROR: /etc/gshadow still inconsistent with /etc/group after sync" >&2
    exit 1
fi

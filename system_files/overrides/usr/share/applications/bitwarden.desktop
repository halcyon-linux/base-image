[Desktop Entry]
Name=Bitwarden
Exec=/opt/Bitwarden/bitwarden --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations %U
Terminal=false
Type=Application
Icon=bitwarden
StartupWMClass=Bitwarden
GenericName=Password Manager
Comment=A secure and free password manager for all of your devices.
MimeType=x-scheme-handler/bitwarden;
Categories=Utility;

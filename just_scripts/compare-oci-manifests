#!/usr/bin/env python3
"""Compare unique compressed layer payloads in two OCI image manifests."""

import argparse
import json
import sys


def layers(manifest):
    if not isinstance(manifest, dict) or not isinstance(manifest.get("layers"), list):
        raise ValueError("manifest must contain a layers array")

    result = {}
    for layer in manifest["layers"]:
        if not isinstance(layer, dict):
            raise ValueError("layer descriptors must be objects")
        digest = layer.get("digest")
        size = layer.get("size")
        if not isinstance(digest, str) or not digest:
            raise ValueError("layer descriptor is missing a digest")
        if isinstance(size, bool) or not isinstance(size, int) or size < 0:
            raise ValueError(f"layer {digest} has an invalid size")
        if digest in result and result[digest] != size:
            raise ValueError(f"layer {digest} has conflicting sizes")
        result[digest] = size
    return result


def read_manifest(path):
    with open(path, encoding="utf-8") as stream:
        return layers(json.load(stream))


def compare(previous, current):
    reused_digests = previous.keys() & current.keys()
    added_digests = current.keys() - previous.keys()
    added = sorted(
        ({"digest": digest, "size": current[digest]} for digest in added_digests),
        key=lambda layer: (-layer["size"], layer["digest"]),
    )
    return {
        "previous_bytes": sum(previous.values()),
        "current_bytes": sum(current.values()),
        "reused_bytes": sum(current[digest] for digest in reused_digests),
        "added_bytes": sum(current[digest] for digest in added_digests),
        "previous_layers": len(previous),
        "current_layers": len(current),
        "reused_layers": len(reused_digests),
        "added_layers": len(added_digests),
        "largest_added_layers": added[:10],
    }


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("previous_manifest")
    parser.add_argument("current_manifest")
    parser.add_argument("--max-added-bytes", type=int, default=1 << 30)
    parser.add_argument("--allow-large-update", action="store_true")
    args = parser.parse_args(argv)

    if args.max_added_bytes < 0:
        parser.error("--max-added-bytes must be non-negative")

    try:
        result = compare(read_manifest(args.previous_manifest), read_manifest(args.current_manifest))
    except (OSError, json.JSONDecodeError, ValueError) as error:
        print(f"manifest comparison failed: {error}", file=sys.stderr)
        return 2

    print(json.dumps(result, sort_keys=True))
    if result["added_bytes"] > args.max_added_bytes:
        message = (
            f"candidate adds {result['added_bytes']} compressed bytes; "
            f"budget is {args.max_added_bytes} bytes"
        )
        if not args.allow_large_update:
            print(f"ERROR: {message}; refusing promotion", file=sys.stderr)
            return 1
        print(f"WARNING: approved large update: {message}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

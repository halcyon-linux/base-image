#!/usr/bin/env bash

set -Eeuo pipefail

requested_target=${target:-${default_target:-alcyone}}
requested_image=${image:-${default_image:-alcyone}}

for requested in "$requested_target" "$requested_image"; do
    case "${requested,,}" in
        ""|alcyone|containerfile) ;;
        *)
            printf 'Only the alcyone image (containerfile branch) is supported (received: %s).\n' \
                "$requested" >&2
            exit 1
            ;;
    esac
done

target=alcyone
image=alcyone

#!/usr/bin/bash
set -eo pipefail
if [[ -z ${project_root} ]]; then
    project_root=$(git rev-parse --show-toplevel)
fi
if [[ -z ${git_branch} ]]; then
    git_branch=$(git branch --show-current)
fi

# Get Inputs
target=$1
image=$2

# Set image/target/version based on inputs
# shellcheck disable=SC2154,SC1091
. "${project_root}/just_scripts/get-defaults"

# Resolve the newest published akmods tag that ships the required device kmod.
# CI does the same, so local and release builds track the same latest usable
# kernel instead of a version hardcoded in the Containerfile.
kernel_flavor=${KERNEL_FLAVOR:-ogc}
fedora_version=${latest:-44}
required_kmod=${REQUIRED_KMOD:-nct6687d}
akmods_tag=${AKMODS_TAG:-}
if [[ -z ${akmods_tag} ]]; then
    akmods_tag=$("${project_root}/just_scripts/resolve-akmods" \
        "${kernel_flavor}" "${fedora_version}" "$(uname -m)" "${required_kmod}")
fi
kernel_version=${KERNEL_VERSION:-${akmods_tag#"${kernel_flavor}-${fedora_version}-"}}

# Verify the upstream images' cosign signatures and build FROM the verified
# digests, the same as CI.
image_args=()
while IFS= read -r line; do
    image_args+=("--build-arg=${line}")
done < <("${project_root}/just_scripts/verify-upstream-images" "${fedora_version}" "${akmods_tag}")
if ((${#image_args[@]} != 5)); then
    echo "Upstream image verification failed; refusing to build." >&2
    exit 1
fi

# Get info
container_mgr=$(just _container_mgr)
tag=$(just _tag "${image}")

# Build Image
$container_mgr build -f Containerfile \
    --build-arg="IMAGE_NAME=${image}" \
    --build-arg="IMAGE_BRANCH=${git_branch}" \
    --build-arg="FEDORA_VERSION=${latest}" \
    --build-arg="KERNEL_FLAVOR=${kernel_flavor}" \
    --build-arg="KERNEL_VERSION=${kernel_version}" \
    --build-arg="AKMODS_TAG=${akmods_tag}" \
    "${image_args[@]}" \
    --target="${target}" \
    --tag localhost/"${tag}:${latest}-${git_branch}" \
    "${project_root}"
